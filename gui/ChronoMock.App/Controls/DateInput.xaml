<UserControl x:Class="ChronoMock.App.Controls.DateInput"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:ChronoMock.App">
  <!-- The shared date input: an ISO date field plus a calendar popup. The value is the ISO text on the
       DataContext (DateText), composed culture-invariantly by whatever owns it, so a Polish box and a US VM
       read a typed date identically (rule 2) - that is why this is NOT a WPF DatePicker, whose text parsing
       follows the OS locale. The calendar binds SelectedDate on the same DataContext: a picked day writes
       the text, a typed valid date moves the calendar.

       🔴 Its own part, split out of MomentInput (2026-09-21), because the date-plus-calendar pair was about
       to appear a third time - the scenario parameters had a bare text box where the setup and the
       calculator had a calendar, and a date typed by hand where every other date on the screen can be
       picked is the kind of gap a first run reads as "this one is broken". MomentInput is this part plus a
       time field. Any DataContext with DateText and SelectedDate can sit under it. -->
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <!-- Wide enough for YYYY-MM-DD with room to spare. The box takes the parts library's TextBox style
         (implicit) and its placeholder, so it reads as the same field the rest of the interface uses. -->
    <TextBox Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}"
             app:PartState.Placeholder="{DynamicResource moment.date_placeholder}"
             ToolTip="{DynamicResource tip.date_field}"
             AutomationProperties.Name="{Binding AccessibleName, ElementName=Root}"
             Width="{StaticResource MomentDateFieldWidth}" FontFamily="{StaticResource FontFamilyMono}"
             VerticalAlignment="Center" />

    <ToggleButton x:Name="CalendarToggle" Style="{StaticResource CalendarToggleStyle}"
                  Margin="{StaticResource SpaceXs}" VerticalAlignment="Center"
                  ToolTip="{DynamicResource action.pick_date}"
                  AutomationProperties.Name="{DynamicResource action.pick_date}" />
    <Popup IsOpen="{Binding IsChecked, ElementName=CalendarToggle}" StaysOpen="False"
           PlacementTarget="{Binding ElementName=CalendarToggle}" Placement="Bottom" AllowsTransparency="True">
      <Border Background="{DynamicResource BrushBgSurfaceAlt}"
              CornerRadius="{StaticResource RadiusSm}" Padding="{StaticResource SpaceXs}">
        <Calendar SelectedDate="{Binding SelectedDate, Mode=TwoWay}" SelectedDatesChanged="OnDatePicked" />
      </Border>
    </Popup>
  </StackPanel>
</UserControl>
