<UserControl x:Class="ChronoMock.App.Controls.MomentInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <!-- Shared moment input (chrono-mock 7.1): an ISO date field plus a calendar popup and an optional 24h
       time field - ONE horizontal line, so it stays level with the buttons and zone beside it. The value is
       composed culture-invariantly by MomentField, so a Polish box and a US VM read a typed date identically
       (rule 2) - that is why this is NOT a WPF DatePicker, whose text parsing follows the OS locale. The
       validation message is shown by the consumer BELOW the whole row (MomentField.ActiveErrorKey), never
       inside this control, so an error never changes the row height. Bound to a MomentField DataContext. -->
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <!-- Wide enough for YYYY-MM-DD plus the wpfui clear button that appears on focus (Width 120 clipped
         the last digit while focused). -->
    <ui:TextBox Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="{DynamicResource moment.date_placeholder}"
                Width="148" FontFamily="{StaticResource FontFamilyMono}"
                VerticalAlignment="Center" />

    <ToggleButton x:Name="CalendarToggle" Style="{StaticResource CalendarToggleStyle}"
                  Margin="{StaticResource SpaceXs}" VerticalAlignment="Center"
                  AutomationProperties.Name="{DynamicResource action.pick_date}" />
    <Popup IsOpen="{Binding IsChecked, ElementName=CalendarToggle}" StaysOpen="False"
           PlacementTarget="{Binding ElementName=CalendarToggle}" Placement="Bottom" AllowsTransparency="True">
      <Border Background="{DynamicResource BrushBgSurfaceAlt}"
              CornerRadius="{StaticResource RadiusSm}" Padding="{StaticResource SpaceXs}">
        <Calendar SelectedDate="{Binding SelectedDate, Mode=TwoWay}" SelectedDatesChanged="OnDatePicked" />
      </Border>
    </Popup>

    <ui:TextBox Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="{DynamicResource moment.time_placeholder}"
                Width="84" FontFamily="{StaticResource FontFamilyMono}"
                Margin="{StaticResource SpaceXs}" VerticalAlignment="Center" />
  </StackPanel>
</UserControl>
