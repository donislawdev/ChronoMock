<UserControl x:Class="ChronoMock.App.Controls.MomentInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:ChronoMock.App"
             xmlns:controls="clr-namespace:ChronoMock.App.Controls">
  <!-- Shared moment input (chrono-mock 7.1): the shared date input (ISO field plus calendar popup, see
       DateInput) and a 24h time field. The value is composed culture-invariantly by MomentField, so a
       Polish box and a US VM read a typed date identically (rule 2). The validation message is shown by
       the consumer BELOW the whole row (MomentField.ActiveErrorKey), never inside this control, so an error
       never changes the row height. Bound to a MomentField DataContext.
       🔴 A WrapPanel, not a horizontal stack. Given the room it lays date, calendar and time on one line and
       stays level with the buttons beside it - a horizontal parent measures it at infinite width, so it never
       wraps there. In a narrow column, the calculator's builder, the time field drops to the next line
       instead of being clipped off the right edge, which a fixed-width stack did. -->
  <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
    <!-- Named for assistive tech: the two fields carry a placeholder and a tooltip, and neither is a
         name, so a screen reader announced two nameless edit boxes. The row's own label (Starts at,
         Jump to) names the row, not the field inside it. -->
    <controls:DateInput VerticalAlignment="Center" AccessibleName="{DynamicResource moment.date_name}" />

    <TextBox Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}"
             app:PartState.Placeholder="{DynamicResource moment.time_placeholder}"
             ToolTip="{DynamicResource tip.time_field}"
             AutomationProperties.Name="{DynamicResource moment.time_name}"
             Width="{StaticResource MomentTimeFieldWidth}" FontFamily="{StaticResource FontFamilyMono}"
             Margin="{StaticResource SpaceXs}" VerticalAlignment="Center" />
  </WrapPanel>
</UserControl>
