<ui:FluentWindow x:Class="ChronoMock.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:ChronoMock.App.Controls"
                 Title="{DynamicResource app.title}"
                 Width="720"
                 Height="580"
                 MinWidth="480"
                 MinHeight="360"
                 Background="{DynamicResource BrushBgBase}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{DynamicResource app.title}" />

    <Grid Grid.Row="1" Margin="{StaticResource SpaceXl}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Target (chrono-mock 7.1: the target sits at the top, its bitness detected automatically). A dev
           sample is pre-selected; the user picks any executable. Start stays disabled until one is chosen. -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="{StaticResource SpaceSm}">
        <TextBlock Text="{DynamicResource target.label}"
                   VerticalAlignment="Center"
                   FontSize="{StaticResource FontSizeBody}"
                   Foreground="{DynamicResource BrushTextSecondary}" />
        <TextBlock Text="{Binding TargetName}"
                   Margin="{StaticResource SpaceXs}"
                   VerticalAlignment="Center"
                   FontSize="{StaticResource FontSizeBody}"
                   Foreground="{DynamicResource BrushTextPrimary}" />
        <Button Margin="{StaticResource SpaceSm}"
                Content="{DynamicResource action.choose_target}"
                Click="OnChooseTargetClick" />
      </StackPanel>

      <!-- The two clocks: fake and real, each from the same tile template, each with its explicit zone. -->
      <Grid Grid.Row="1" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <controls:ClockTile Grid.Column="0" Margin="{StaticResource SpaceSm}" DataContext="{Binding Fake}" />
        <controls:ClockTile Grid.Column="1" Margin="{StaticResource SpaceSm}" DataContext="{Binding Real}" />
      </Grid>

      <!-- Verdict indicator (chrono-mock 7.1), visible once a verdict arrives. The verdict is told apart
           by the glyph and the label, not by colour alone (zasady/13 9); the colour reinforces it. The
           reason and the plain-language meaning show only for a non-works verdict. -->
      <StackPanel Grid.Row="2"
                  Margin="{StaticResource SpaceMd}"
                  Visibility="{Binding VerdictKnown, Converter={StaticResource BoolToVis}}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock Text="{Binding VerdictKind, Converter={StaticResource VerdictGlyph}}"
                     FontSize="{StaticResource FontSizeSubtitle}"
                     Foreground="{Binding VerdictKind, Converter={StaticResource VerdictBrush}}" />
          <TextBlock Text="{Binding VerdictLabelKey, Converter={StaticResource KeyToText}}"
                     Margin="{StaticResource SpaceXs}"
                     FontSize="{StaticResource FontSizeSubtitle}"
                     FontWeight="SemiBold"
                     Foreground="{Binding VerdictKind, Converter={StaticResource VerdictBrush}}" />
        </StackPanel>
        <TextBlock Text="{Binding VerdictReasonKey, Converter={StaticResource KeyToText}}"
                   TextAlignment="Center"
                   FontSize="{StaticResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushTextSecondary}"
                   Visibility="{Binding VerdictHasReason, Converter={StaticResource BoolToVis}}" />
        <TextBlock Text="{Binding VerdictMeaningKey, Converter={StaticResource KeyToText}}"
                   Margin="{StaticResource SpaceXs}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="{StaticResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushTextSecondary}"
                   Visibility="{Binding VerdictHasMeaning, Converter={StaticResource BoolToVis}}" />
      </StackPanel>

      <!-- Coverage detail (chrono-mock 7.2 audit preview), visible once a coverage report arrives. Section
           headers carry a synthesized count (zasady/13 10). Uncovered channels wear the partial colour. -->
      <ScrollViewer Grid.Row="3"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding CoverageKnown, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <TextBlock Margin="{StaticResource SpaceXs}"
                     Text="{DynamicResource coverage.family_note}"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     FontSize="{StaticResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushTextSecondary}"
                     Visibility="{Binding IsFamily, Converter={StaticResource BoolToVis}}" />

          <StackPanel Margin="{StaticResource SpaceXs}"
                      Visibility="{Binding HasCovered, Converter={StaticResource BoolToVis}}">
            <TextBlock FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextSecondary}">
              <Run Text="{DynamicResource coverage.covered}" /><Run Text="{Binding Covered.Count, StringFormat=' ({0})', Mode=OneWay}" />
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Covered}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}"
                             FontSize="{StaticResource FontSizeBody}"
                             Foreground="{DynamicResource BrushTextPrimary}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Margin="{StaticResource SpaceXs}"
                      Visibility="{Binding HasObserved, Converter={StaticResource BoolToVis}}">
            <TextBlock FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextSecondary}">
              <Run Text="{DynamicResource coverage.observed}" /><Run Text="{Binding Observed.Count, StringFormat=' ({0})', Mode=OneWay}" />
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Observed}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}"
                             FontSize="{StaticResource FontSizeBody}"
                             Foreground="{DynamicResource BrushTextSecondary}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Margin="{StaticResource SpaceXs}"
                      Visibility="{Binding HasUncovered, Converter={StaticResource BoolToVis}}">
            <TextBlock FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushStatusPartial}">
              <Run Text="{DynamicResource coverage.uncovered}" /><Run Text="{Binding Uncovered.Count, StringFormat=' ({0})', Mode=OneWay}" />
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Uncovered}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}"
                             FontSize="{StaticResource FontSizeBody}"
                             Foreground="{DynamicResource BrushTextPrimary}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Margin="{StaticResource SpaceXs}"
                      Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
            <TextBlock FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushStatusPartial}">
              <Run Text="{DynamicResource coverage.warnings}" /><Run Text="{Binding Warnings.Count, StringFormat=' ({0})', Mode=OneWay}" />
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Warnings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource KeyToText}}"
                             TextWrapping="Wrap"
                             FontSize="{StaticResource FontSizeBody}"
                             Foreground="{DynamicResource BrushTextPrimary}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Status and rate. The meaning is carried by the translated label, not by colour (zasady/13 9). -->
      <StackPanel Grid.Row="4" Margin="{StaticResource SpaceMd}" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock Text="{Binding StatusKey, Converter={StaticResource KeyToText}}"
                     FontSize="{StaticResource FontSizeBody}"
                     Foreground="{DynamicResource BrushTextPrimary}" />
          <TextBlock Text="{Binding MultiplierText}"
                     Margin="{StaticResource SpaceSm}"
                     FontSize="{StaticResource FontSizeBody}"
                     Foreground="{DynamicResource BrushTextSecondary}" />
        </StackPanel>
        <TextBlock Text="{Binding LastError}"
                   FontSize="{StaticResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushTextSecondary}"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>

      <Button Grid.Row="5"
              Margin="{StaticResource SpaceSm}"
              HorizontalAlignment="Center"
              Content="{DynamicResource action.start}"
              IsEnabled="{Binding CanStart}"
              Click="OnStartClick" />
    </Grid>
  </Grid>
</ui:FluentWindow>
