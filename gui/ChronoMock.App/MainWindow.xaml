<ui:FluentWindow x:Class="ChronoMock.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:ChronoMock.App.Controls"
                 xmlns:views="clr-namespace:ChronoMock.App.Views"
                 Title="{DynamicResource app.title}"
                 Width="1040"
                 Height="800"
                 MinWidth="640"
                 MinHeight="360"
                 Background="{DynamicResource BrushBgBase}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{DynamicResource app.title}" />

    <!-- Module switch: the two halves of the product (substitution, calculator) share one window. The
         calculator is a separate view swapped into the content cell below. Meaning is carried by the
         label, never colour alone (zasady/13 9), and both options are keyboard-reachable radio buttons. -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="{StaticResource SpaceSm}">
      <RadioButton x:Name="ModeSubstitution" GroupName="AppMode" IsChecked="True" Checked="OnModeChanged"
                   Content="{DynamicResource nav.substitution}" Margin="{StaticResource SpaceXs}" />
      <RadioButton x:Name="ModeCalculator" GroupName="AppMode" Checked="OnModeChanged"
                   Content="{DynamicResource nav.calculator}" Margin="{StaticResource SpaceXs}" />
    </StackPanel>

    <!-- Content cell: the substitution panel (default) and the calculator view occupy the same cell,
         toggled by the module switch above. -->
    <Grid Grid.Row="2">

    <!-- The whole panel scrolls when it does not fit, so no row is ever clipped at a small window size or
         a large system scale (zasady/13 2.1 - computed layout over hard geometry). -->
    <ScrollViewer x:Name="SubstitutionContainer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="{StaticResource SpaceXl}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Setup: what to run (target), when (moment in the session zone), how fast (mode). chrono-mock 7.1.
             Target, zone and scale-duration are start-only (locked while running); the moment and mode stay
             editable and act live in flight (moment -> jump to it, mode -> set_multiplier). -->
        <StackPanel Grid.Row="0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="{StaticResource SpaceXs}"
                      IsEnabled="{Binding IsIdle}">
            <TextBlock Text="{DynamicResource target.label}" VerticalAlignment="Center"
                       FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" />
            <TextBlock Text="{Binding TargetName}" Margin="{StaticResource SpaceXs}" VerticalAlignment="Center"
                       FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}" />
            <Button Margin="{StaticResource SpaceSm}" Content="{DynamicResource action.choose_target}"
                    ToolTip="{DynamicResource tip.choose_target}" Click="OnChooseTargetClick" />
          </StackPanel>

          <!-- One centred line: At label, the date/calendar/time input, the Today/Now quick fills, the
               in-flight Jump, and the zone. The validation message is a SEPARATE line below (not inside the
               date control), so it never changes this row's height or knocks the inputs out of alignment. -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="{StaticResource SpaceXs}">
            <TextBlock Text="{DynamicResource moment.label}" VerticalAlignment="Center"
                       FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" />
            <controls:MomentInput DataContext="{Binding Moment}"
                                  IsEnabled="{Binding DataContext.CanEditTime, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}}"
                                  Margin="{StaticResource SpaceXs}" VerticalAlignment="Center" />
            <!-- Quick fills: Today (midnight) and Now, both computed in the SESSION zone (rule 2), never the
                 OS clock - the panel passes its selected zone's bias so the control stays zone-agnostic. -->
            <Button Content="{DynamicResource action.today}" Click="OnTodayClick"
                    ToolTip="{DynamicResource tip.today}"
                    IsEnabled="{Binding CanEditTime}" Margin="{StaticResource SpaceXs}" VerticalAlignment="Center" />
            <Button Content="{DynamicResource action.now}" Click="OnNowClick"
                    ToolTip="{DynamicResource tip.now}"
                    IsEnabled="{Binding CanEditTime}" Margin="{StaticResource SpaceXs}" VerticalAlignment="Center" />
            <!-- In-flight: jump the wall to the ABSOLUTE moment on the left (visible only while running).
                 Disabled for a malformed moment; the core validates deeper and reports a bad one without
                 ending the session (per-command error). -->
            <Button Content="{DynamicResource action.jump_to}" Click="OnJumpToClick"
                    ToolTip="{DynamicResource tip.jump_to}"
                    IsEnabled="{Binding Moment.IsValid}" VerticalAlignment="Center" Margin="{StaticResource SpaceXs}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{DynamicResource zone.label}" Margin="{StaticResource SpaceSm}" VerticalAlignment="Center"
                       FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" />
            <ComboBox ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}"
                      IsEnabled="{Binding IsIdle}" ToolTip="{DynamicResource tip.zone}"
                      Margin="{StaticResource SpaceXs}" VerticalAlignment="Center">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock><Run Text="{Binding Label, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding HintKey, Converter={StaticResource KeyToText}, Mode=OneWay}" /></TextBlock>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <!-- Validation message BELOW the whole At row: centred, in the partial-status colour, meaning in
               the text. Kept out of the input control so its appearance never shifts the row (rule: steady
               layout). -->
          <TextBlock Text="{Binding Moment.ActiveErrorKey, Converter={StaticResource KeyToText}}"
                     Visibility="{Binding Moment.HasError, Converter={StaticResource BoolToVis}}"
                     HorizontalAlignment="Center" Margin="{StaticResource SpaceXs}" TextWrapping="Wrap"
                     FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushStatusPartial}" />

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="{StaticResource SpaceXs}">
            <TextBlock Text="{DynamicResource mode.label}" VerticalAlignment="Center"
                       FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" />
            <ComboBox x:Name="ModeBox" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                      ItemContainerStyle="{StaticResource LabelKeyComboItem}"
                      IsEnabled="{Binding CanEditTime}" ToolTip="{DynamicResource tip.mode}"
                      Margin="{StaticResource SpaceXs}" VerticalAlignment="Center">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding LabelKey, Converter={StaticResource KeyToText}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <!-- Scale the duration axis too (chrono-mock 11.1 pt 4): with a multiplier, a countdown or timer
               inside the target runs N times faster, not just the wall clock. Maps to wire scale_duration. -->
          <CheckBox Content="{DynamicResource mode.scale_duration}"
                    IsChecked="{Binding ScaleDuration}"
                    IsEnabled="{Binding IsIdle}" ToolTip="{DynamicResource tip.scale_duration}"
                    HorizontalAlignment="Center" Margin="{StaticResource SpaceXs}"
                    FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" />

          <!-- Scale QueryPerformanceCounter too (ADR-2 reversal, opt-in): a QPC-based monotonic/elapsed clock
               (Python monotonic, .NET Stopwatch, Java nanoTime) accelerates as well. Separate because it can
               distort a target that times its rendering off QPC. Maps to wire scale_qpc. -->
          <CheckBox Content="{DynamicResource mode.scale_qpc}"
                    IsChecked="{Binding ScaleQpc}"
                    IsEnabled="{Binding IsIdle}" ToolTip="{DynamicResource tip.scale_qpc}"
                    HorizontalAlignment="Center" Margin="{StaticResource SpaceXs}"
                    FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" />

        </StackPanel>

        <Button Grid.Row="1" Margin="{StaticResource SpaceSm}" HorizontalAlignment="Center"
                Content="{DynamicResource action.start}" IsEnabled="{Binding CanStart}" Click="OnStartClick"
                ToolTip="{DynamicResource tip.start}" ToolTipService.ShowOnDisabled="True" />

        <!-- The two clocks: fake and real, each from the same tile template, each with its explicit zone. -->
        <Grid Grid.Row="2" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:ClockTile Grid.Column="0" Margin="{StaticResource SpaceSm}" DataContext="{Binding Fake}" />
          <controls:ClockTile Grid.Column="1" Margin="{StaticResource SpaceSm}" DataContext="{Binding Real}" />
        </Grid>

        <!-- Verdict indicator (chrono-mock 7.1), visible once a verdict arrives. The verdict is told apart
             by the glyph and the label, not by colour alone (zasady/13 9); the colour reinforces it. The
             reason and the plain-language meaning show only for a non-works verdict. -->
        <StackPanel Grid.Row="3"
                    Margin="{StaticResource SpaceMd}"
                    Visibility="{Binding VerdictKnown, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="{Binding VerdictKind, Converter={StaticResource VerdictGlyph}}"
                       FontSize="{StaticResource FontSizeSubtitle}"
                       Foreground="{Binding VerdictKind, Converter={StaticResource VerdictBrush}}" />
            <TextBlock Text="{Binding VerdictLabelKey, Converter={StaticResource KeyToText}}"
                       Margin="{StaticResource SpaceXs}"
                       FontSize="{StaticResource FontSizeSubtitle}"
                       FontWeight="SemiBold"
                       Foreground="{Binding VerdictKind, Converter={StaticResource VerdictBrush}}" />
          </StackPanel>
          <TextBlock Text="{Binding VerdictReasonKey, Converter={StaticResource KeyToText}}"
                     TextAlignment="Center"
                     FontSize="{StaticResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushTextSecondary}"
                     Visibility="{Binding VerdictHasReason, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{Binding VerdictMeaningKey, Converter={StaticResource KeyToText}}"
                     Margin="{StaticResource SpaceXs}"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     FontSize="{StaticResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushTextSecondary}"
                     Visibility="{Binding VerdictHasMeaning, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- Coverage detail (chrono-mock 7.2 audit preview), visible once a coverage report arrives. Section
             headers carry a synthesized count (zasady/13 10). Uncovered channels wear the partial colour.
             It scrolls within a capped height so a long channel list never pushes the controls off-screen. -->
        <ScrollViewer Grid.Row="4"
                      MaxHeight="{StaticResource CoverageMaxHeight}"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CoverageKnown, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Margin="{StaticResource SpaceXs}"
                       Text="{Binding CoverageNoteKey, Converter={StaticResource KeyToText}}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       Visibility="{Binding HasCoverageNote, Converter={StaticResource BoolToVis}}" />

            <StackPanel Margin="{StaticResource SpaceXs}"
                        Visibility="{Binding HasCovered, Converter={StaticResource BoolToVis}}">
              <TextBlock FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextSecondary}">
                <Run Text="{DynamicResource coverage.covered}" /><Run Text="{Binding Covered.Count, StringFormat=' ({0})', Mode=OneWay}" />
              </TextBlock>
              <ItemsControl ItemsSource="{Binding Covered}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource BrushTextPrimary}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Margin="{StaticResource SpaceXs}"
                        Visibility="{Binding HasObserved, Converter={StaticResource BoolToVis}}">
              <TextBlock FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextSecondary}">
                <Run Text="{DynamicResource coverage.observed}" /><Run Text="{Binding Observed.Count, StringFormat=' ({0})', Mode=OneWay}" />
              </TextBlock>
              <ItemsControl ItemsSource="{Binding Observed}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource BrushTextSecondary}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Margin="{StaticResource SpaceXs}"
                        Visibility="{Binding HasUncovered, Converter={StaticResource BoolToVis}}">
              <TextBlock FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushStatusPartial}">
                <Run Text="{DynamicResource coverage.uncovered}" /><Run Text="{Binding Uncovered.Count, StringFormat=' ({0})', Mode=OneWay}" />
              </TextBlock>
              <ItemsControl ItemsSource="{Binding Uncovered}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource BrushTextPrimary}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Margin="{StaticResource SpaceXs}"
                        Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
              <TextBlock FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushStatusPartial}">
                <Run Text="{DynamicResource coverage.warnings}" /><Run Text="{Binding Warnings.Count, StringFormat=' ({0})', Mode=OneWay}" />
              </TextBlock>
              <ItemsControl ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource KeyToText}}"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource BrushTextPrimary}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- In-flight controls (chrono-mock 7.2), shown only while a session runs: speed (each button's
             multiplier in Tag, Freeze = set_multiplier(0)) and jump (each button's relative delta in Tag).
             The core re-anchors continuously (ADR-5); a backward jump never rewinds the duration (rule 3). -->
        <StackPanel Grid.Row="5" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="{StaticResource SpaceXs}">
            <Button Content="{DynamicResource mode.x1}" Tag="1" Margin="{StaticResource SpaceXs}" Click="OnSpeedClick" />
            <Button Content="{DynamicResource mode.x10}" Tag="10" Margin="{StaticResource SpaceXs}" Click="OnSpeedClick" />
            <Button Content="{DynamicResource mode.x60}" Tag="60" Margin="{StaticResource SpaceXs}" Click="OnSpeedClick" />
            <Button Content="{DynamicResource mode.x1440}" Tag="1440" Margin="{StaticResource SpaceXs}" Click="OnSpeedClick" />
            <Button Content="{DynamicResource action.freeze}" Tag="0" Margin="{StaticResource SpaceSm}"
                    ToolTip="{DynamicResource tip.freeze}" Click="OnSpeedClick" />
            <!-- Arbitrary speed: type any N and Set (the preset buttons and the Mode dropdown cover the
                 common ones; this is for a value like x500). -->
            <TextBox x:Name="CustomSpeedBox" Width="56" Margin="{StaticResource SpaceSm}" VerticalAlignment="Center"
                     FontSize="{StaticResource FontSizeBody}" />
            <Button Content="{DynamicResource action.set_speed}" Click="OnSetSpeedClick" VerticalAlignment="Center"
                    ToolTip="{DynamicResource tip.set_speed}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="{StaticResource SpaceXs}">
            <Button Content="{DynamicResource jump.minus_day}" Tag="-1d" Margin="{StaticResource SpaceXs}" Click="OnJumpClick" />
            <Button Content="{DynamicResource jump.minus_hour}" Tag="-1h" Margin="{StaticResource SpaceXs}" Click="OnJumpClick" />
            <Button Content="{DynamicResource jump.plus_hour}" Tag="+1h" Margin="{StaticResource SpaceXs}" Click="OnJumpClick" />
            <Button Content="{DynamicResource jump.plus_day}" Tag="+1d" Margin="{StaticResource SpaceXs}" Click="OnJumpClick" />
          </StackPanel>
          <!-- Stop the session on demand (chrono-mock 7.2, M-10): the meaning is in the label, not colour
               (zasady/13 9). It ends the core cleanly (or kills a hung one), the hook self-detaches, and the
               target returns to real time - the app under test is never killed. -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="{StaticResource SpaceXs}">
            <Button Content="{DynamicResource control.stop}" Margin="{StaticResource SpaceXs}"
                    ToolTip="{DynamicResource tip.stop}" Click="OnStopClick" />
          </StackPanel>
        </StackPanel>

        <!-- Status and rate. The meaning is carried by the translated label, not by colour (zasady/13 9). -->
        <StackPanel Grid.Row="6" Margin="{StaticResource SpaceMd}" HorizontalAlignment="Center">
          <!-- Copy the paste-into-ticket session summary (chrono-mock 7.2, 8.8), available once a session has
               started. A non-works session's summary leads with an unreliable-evidence banner. Beside it, for
               a session that did not cleanly succeed, Copy diagnostics puts the core's stderr on the clipboard
               for a support ticket (RELEASE-012). Both buttons share the copy feedback line below. -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="{DynamicResource action.copy_summary}"
                    Margin="{StaticResource SpaceXs}"
                    ToolTip="{DynamicResource tip.copy_summary}"
                    Visibility="{Binding CanCopySummary, Converter={StaticResource BoolToVis}}"
                    Click="OnCopySummaryClick" />
            <Button Content="{DynamicResource action.copy_diagnostics}"
                    Margin="{StaticResource SpaceXs}"
                    ToolTip="{DynamicResource tip.copy_diagnostics}"
                    Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVis}}"
                    Click="OnCopyDiagnosticsClick" />
          </StackPanel>
          <TextBlock Text="{Binding CopyFeedbackKey, Converter={StaticResource KeyToText}}"
                     Margin="{StaticResource SpaceXs}"
                     HorizontalAlignment="Center"
                     FontSize="{StaticResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushTextSecondary}" />
          <!-- Where the diagnostics log was written, so the user knows which file to attach to a report. Only
               shown when a file was actually saved (a read-only medium leaves the Copy button as the path). -->
          <TextBlock Visibility="{Binding HasDiagnosticsSaved, Converter={StaticResource BoolToVis}}"
                     Margin="{StaticResource SpaceXs}"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     FontSize="{StaticResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushTextSecondary}">
            <Run Text="{DynamicResource diagnostics.saved}" /><Run Text="{Binding DiagnosticsSavedPath, StringFormat=' {0}', Mode=OneWay}" />
          </TextBlock>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="{Binding StatusKey, Converter={StaticResource KeyToText}}"
                       FontSize="{StaticResource FontSizeBody}"
                       Foreground="{DynamicResource BrushTextPrimary}" />
            <TextBlock Text="{Binding MultiplierText}"
                       Margin="{StaticResource SpaceSm}"
                       FontSize="{StaticResource FontSizeBody}"
                       Foreground="{DynamicResource BrushTextSecondary}" />
          </StackPanel>
          <TextBlock Text="{Binding LastError}"
                     FontSize="{StaticResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushTextSecondary}"
                     HorizontalAlignment="Center"
                     TextWrapping="Wrap" />
          <!-- A per-command in-flight error (e.g. a bad jump moment): shown without ending the session. -->
          <TextBlock Text="{Binding InFlightErrorKey, Converter={StaticResource KeyToText}}"
                     Visibility="{Binding HasInFlightError, Converter={StaticResource BoolToVis}}"
                     FontSize="{StaticResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushStatusPartial}"
                     HorizontalAlignment="Center"
                     TextWrapping="Wrap" />
          <!-- Final-state notes from `ended`: the target's own exit code (informational, shown when the app
               exited on its own) and any cleanup residue the core could not remove (a locked CDP temp
               profile). Both surfaced honestly instead of dropped (rule 6). -->
          <TextBlock Visibility="{Binding HasTargetExit, Converter={StaticResource BoolToVis}}"
                     FontSize="{StaticResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushTextSecondary}"
                     HorizontalAlignment="Center">
            <Run Text="{DynamicResource report.target_exit}" /><Run Text="{Binding TargetExitCode, StringFormat=' {0}', Mode=OneWay}" />
          </TextBlock>
          <ItemsControl ItemsSource="{Binding ResidueKeys}"
                        Visibility="{Binding HasResidue, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource KeyToText}}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushStatusPartial}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Session history (chrono-mock 7.2, 8.8, 11.1 pt 13), shown once there is a recorded session.
             Clicking an entry FILLS the setup form and never starts a session (rule 7, docs/04 section 6).
             It scrolls within a capped height so a long history never dominates the panel. -->
        <Expander Grid.Row="7"
                  Margin="{StaticResource SpaceMd}"
                  Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
          <Expander.Header>
            <TextBlock FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}">
              <Run Text="{DynamicResource history.header}" /><Run Text="{Binding History.Count, StringFormat=' ({0})', Mode=OneWay}" />
            </TextBlock>
          </Expander.Header>
          <StackPanel>
            <TextBlock Margin="{StaticResource SpaceXs}"
                       TextWrapping="Wrap"
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushStatusPartial}"
                       Visibility="{Binding HasHistoryError, Converter={StaticResource BoolToVis}}">
              <Run Text="{DynamicResource history.save_failed}" /><Run Text="{Binding HistoryError, Mode=OneWay}" />
            </TextBlock>
            <ScrollViewer MaxHeight="{StaticResource HistoryMaxHeight}" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <!-- Two siblings, never nested buttons: the row loads the session (fills the form,
                         rule 7), the trailing button deletes it. -->
                    <Grid Margin="{StaticResource SpaceXs}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Button Grid.Column="0" Click="OnHistoryClick" Tag="{Binding}"
                              AutomationProperties.Name="{Binding TargetName}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding VerdictKind, Converter={StaticResource VerdictGlyph}}"
                                     Foreground="{Binding VerdictKind, Converter={StaticResource VerdictBrush}}"
                                     FontSize="{StaticResource FontSizeBody}" />
                          <TextBlock Text="{Binding TargetName}"
                                     Margin="{StaticResource SpaceXs}"
                                     FontSize="{StaticResource FontSizeBody}"
                                     Foreground="{DynamicResource BrushTextPrimary}" />
                          <TextBlock Text="{Binding MomentLocal}"
                                     Margin="{StaticResource SpaceXs}"
                                     FontSize="{StaticResource FontSizeCaption}"
                                     Foreground="{DynamicResource BrushTextSecondary}" />
                          <TextBlock Text="{Binding EndedAtUtc}"
                                     Margin="{StaticResource SpaceXs}"
                                     FontSize="{StaticResource FontSizeCaption}"
                                     Foreground="{DynamicResource BrushTextSecondary}" />
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="1" Click="OnHistoryDeleteClick" Tag="{Binding}"
                              Content="✕"
                              AutomationProperties.Name="{DynamicResource history.delete}"
                              Margin="{StaticResource SpaceXs}"
                              FontSize="{StaticResource FontSizeCaption}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Button Content="{DynamicResource history.clear}"
                    Click="OnHistoryClearClick"
                    HorizontalAlignment="Center"
                    Margin="{StaticResource SpaceSm}" />
          </StackPanel>
        </Expander>
      </Grid>
    </ScrollViewer>

      <!-- Date calculator (chrono-mock 7.3), hidden until the module switch selects it. -->
      <views:CalculatorView x:Name="CalculatorContainer" Visibility="Collapsed" />
    </Grid>
  </Grid>
</ui:FluentWindow>
