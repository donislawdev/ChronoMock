<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Custom dark control templates (zasady/13): the calendar toggle and the checkbox, so their checked and
    hover states read cleanly on the dark base instead of the low-contrast wpfui defaults. This file lives
    under Themes/, where design values (sizes, thicknesses) are DEFINED, so literals here are intentional
    (the literal guard scans views, not Themes/). Colours still come from the named palette.
  -->

  <!-- Calendar popup toggle (MomentInput): a quiet icon button. Checked (popup open) shows a subtle surface
       fill and an accent border - never the light fill the default wpfui ToggleButton paints on dark. -->
  <Style x:Key="CalendarToggleStyle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                  BorderThickness="1" CornerRadius="4" Padding="7,6" SnapsToDevicePixels="True">
            <!-- Segoe MDL2 Assets calendar glyph: a crisp monochrome icon in the current foreground,
                 shipped on the TFM floor (Win10 1809). -->
            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                       Foreground="{TemplateBinding Foreground}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushBgSurfaceAlt}" />
              <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushBgSurfaceAlt}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
              <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushFocusRing}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Checkbox: a clear 20px box with an accent fill and a dark tick when checked, on the dark base -
       replaces the low-contrast wpfui default. Two-state (the app has no tri-state checkbox). The label
       keeps whatever Foreground/FontSize the usage sets (inherited by the ContentPresenter). -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource BrushBgSurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushStroke}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="20" Height="20" CornerRadius="4"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    SnapsToDevicePixels="True">
              <Path x:Name="Tick" Width="12" Height="12" Stretch="Uniform"
                    Data="M 3,8 L 6.5,11.5 L 13,4"
                    Stroke="{DynamicResource BrushBgBase}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Visibility="Collapsed" />
            </Border>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrushAccent}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
              <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushFocusRing}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 🔴 THE PRIMARY ACTION, templated because the stock one CANNOT hold a colour. The panel's main
       button carried its accent as a local Background, and the wpfui template repaints a NAMED PART of
       itself on hover - a template part is not the control, so the local value never competed with it.
       What the user saw was the one findable control on the screen dropping to grey the moment the
       pointer arrived, which reads as "disabled", not as "hovered".

       The states are painted as a VEIL over whatever fill the usage sets, rather than as a second and a
       third named colour per button. That is what lets one template serve both an accent Start and a red
       Stop: lighter on hover, darker while pressed, in either colour, with no palette entry that exists
       only to be a shade of another one. Dimmed rather than greyed when disabled, like the checkbox and
       the calendar toggle above, so a disabled primary action still reads as the colour it will be. -->
  <Style x:Key="PrimaryActionButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushBgBase}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinWidth" Value="{DynamicResource PrimaryActionMinWidth}" />
    <Setter Property="Padding" Value="{StaticResource SpaceMd}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Fill" Background="{TemplateBinding Background}"
                    BorderBrush="Transparent" BorderThickness="{StaticResource StrokeThinEdge}"
                    CornerRadius="{StaticResource RadiusSm}" SnapsToDevicePixels="True" />
            <!-- Always in the tree and only ever changing opacity, so a state never moves the button. -->
            <Border x:Name="Veil" Background="{DynamicResource BrushTextPrimary}" Opacity="0"
                    CornerRadius="{StaticResource RadiusSm}" IsHitTestVisible="False" />
            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Veil" Property="Opacity" Value="0.14" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Veil" Property="Background" Value="{DynamicResource BrushBgBase}" />
              <Setter TargetName="Veil" Property="Opacity" Value="0.24" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource BrushFocusRing}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A title-bar action: the veil mechanics of the primary action above, with no fill of its own.
       Deliberately quiet. It shares a strip with the minimise, maximise and close buttons, and anything
       filled or accented there would read as more important than Start, which is the one control on this
       window that should pull the eye. Secondary text on no background is the same weight the window
       title next to it carries, so the strip stays one thing rather than a button bolted onto it.

       The veil is the only thing that moves, so hover and press never shift the label by a pixel in a
       strip where a shifting control sits next to the close button. -->
  <Style x:Key="TitleBarActionButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="Padding" Value="{StaticResource SpaceSm}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Fill" Background="{TemplateBinding Background}"
                    BorderBrush="Transparent" BorderThickness="{StaticResource StrokeThinEdge}"
                    CornerRadius="{StaticResource RadiusSm}" SnapsToDevicePixels="True" />
            <Border x:Name="Veil" Background="{DynamicResource BrushTextPrimary}" Opacity="0"
                    CornerRadius="{StaticResource RadiusSm}" IsHitTestVisible="False" />
            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <!-- Hover brightens the label as well as the ground. On a control this quiet the veil alone
                 is easy to miss, and the label going from secondary to primary is what says "this is a
                 button" to somebody who has not hovered it before. -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Veil" Property="Opacity" Value="0.1" />
              <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Veil" Property="Opacity" Value="0.18" />
            </Trigger>
            <!-- The focus ring matters more here than on a filled button: keyboard users reach this
                 through a strip whose other buttons are drawn by Windows, not by us. -->
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource BrushFocusRing}" />
              <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tooltip: dark surface, readable text, wrapped - the default WPF tooltip is a light-yellow box that
       is jarring and low-contrast on the dark base. Content is a translation key's text (rule 15). -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource BrushBgSurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushStroke}" />
    <Setter Property="MaxWidth" Value="320" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="4" Padding="10,6" SnapsToDevicePixels="True">
            <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap"
                       Foreground="{TemplateBinding Foreground}" FontSize="{DynamicResource FontSizeCaption}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
