<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!--
    Design VALUES - one source, referenced by name (zasady/13 section 2.1). Views point at these
    names, never at raw numbers, and the literal guard reddens on a raw number in a design attribute.
    Values live before styles because StaticResource resolves as the file is read.
  -->

  <!-- Closed spacing scale (uniform Thickness). A view that wants 7 takes the nearest named step - the
       scale cannot be bypassed without tripping the guard (zasady/13 sections 2.2 and 2.3). -->
  <Thickness x:Key="SpaceXs">4</Thickness>
  <Thickness x:Key="SpaceSm">8</Thickness>
  <Thickness x:Key="SpaceMd">12</Thickness>
  <Thickness x:Key="SpaceLg">16</Thickness>
  <Thickness x:Key="SpaceXl">24</Thickness>
  <Thickness x:Key="SpaceXxl">32</Thickness>

  <!-- Typography: a fixed set of size roles, not a free axis. Caption is the legibility floor. -->
  <!-- Monospace family for data columns (timestamps, epoch, FILETIME) so digits align (calculator 7.3).
       A named design value, not a literal per view (zasady/13 2.1). Consolas ships on the TFM floor
       (Win10 1809), so it always resolves. The default UI face stays Segoe (no key needed for it). -->
  <FontFamily x:Key="FontFamilyMono">Consolas</FontFamily>
  <sys:Double x:Key="FontSizeCaption">12</sys:Double>
  <sys:Double x:Key="FontSizeBody">14</sys:Double>
  <sys:Double x:Key="FontSizeSubtitle">18</sys:Double>
  <sys:Double x:Key="FontSizeTitle">24</sys:Double>
  <sys:Double x:Key="FontSizeClock">34</sys:Double>

  <!-- Radii and stroke. Three radii with three jobs, not a free axis: control, card, pill. The pill
       radius is half the control height, which is what makes a pill a pill at any height. -->
  <CornerRadius x:Key="RadiusSm">4</CornerRadius>
  <CornerRadius x:Key="RadiusMd">8</CornerRadius>
  <CornerRadius x:Key="RadiusPill">16</CornerRadius>

  <!--
    Control metrics. A template that writes its own numbers is the same failure as a view that does,
    and it is worse there, because no render-side guard measures inside a template (see the note in
    XamlLiteralGuard). So the shapes of the parts library are named here like everything else.

    32 is the control height: two 16s, on the spacing scale, and the height at which a 14 px label has
    room to breathe without the control dominating a form row. The pill radius above is half of it.
  -->
  <sys:Double x:Key="ControlHeight">32</sys:Double>
  <!-- A control is never narrower than it is tall. Rendered without this, a button labelled "+" came out
       a fifth of its own height and was a worse target than the text it held. -->
  <sys:Double x:Key="ControlMinWidth">32</sys:Double>
  <Thickness x:Key="ControlPadding">12,0,12,0</Thickness>
  <Thickness x:Key="CardPadding">16</Thickness>
  <Thickness x:Key="ChipPadding">12,8,12,8</Thickness>

  <!-- The keyboard focus ring sits OUTSIDE the control edge, so a focused control does not change size
       and its neighbours do not shift. Two pixels: one is invisible next to a one pixel border. -->
  <Thickness x:Key="FocusRingThickness">2</Thickness>
  <Thickness x:Key="FocusRingMargin">-3</Thickness>
  <sys:Double x:Key="StrokeThin">1</sys:Double>
  <!-- The same one-pixel edge as a Thickness, for a BorderThickness. WPF does not convert a Double to a
       Thickness through a resource reference, so the two spellings of one decision both have to exist. -->
  <Thickness x:Key="StrokeThinEdge">1</Thickness>

  <!-- Layout cap: the coverage audit list scrolls inside this height instead of pushing the in-flight
       controls off-screen. A named cap, not free geometry (zasady/13 2.1); the whole panel also scrolls,
       so nothing is ever clipped. -->
  <sys:Double x:Key="CoverageMaxHeight">140</sys:Double>

  <!-- The history list scrolls inside this height so a long history never dominates the panel. Named cap,
       not free geometry (zasady/13 2.1); the whole panel also scrolls. -->
  <sys:Double x:Key="HistoryMaxHeight">160</sys:Double>

  <!-- Vertical-only gaps, for a stack whose items share a left edge. The scale above is uniform on all
       four sides, which is right for a centred row and wrong here: a uniform margin also indents, so a
       column of blocks each carrying one ends up with as many left edges as it has spacings. Measured on
       the first About render, which had three. -->
  <Thickness x:Key="StackGapSm">0,8,0,0</Thickness>
  <Thickness x:Key="StackGapLg">0,16,0,0</Thickness>

  <!-- The component register scrolls inside this height once the About window's expander is opened. The
       cap is what keeps that window a window: the list runs to some forty components, and a dialog that
       sizes to its content would otherwise grow taller than the screen the moment somebody opened it. -->
  <sys:Double x:Key="ComponentsMaxHeight">180</sys:Double>

  <!-- The About window is narrower than the main one and wider than a message box: wide enough that the
       warranty paragraph reads in three lines rather than seven, narrow enough to stay a dialog. -->
  <sys:Double x:Key="AboutWidth">520</sys:Double>

  <!-- The target box caps here so a deeply nested path cannot stretch the centred setup row across the
       window; the name is what identifies the target, and the full path is in the tooltip. -->
  <!-- The primary action is wider than the buttons around it, because size is half of what makes an
       action look primary - the accent fill alone reads as decoration on a control the same size as its
       neighbours. Named here rather than written into the view, like every other design value. -->
  <sys:Double x:Key="PrimaryActionMinWidth">220</sys:Double>

  <!-- Dialog answers are the same width as each other whatever they say, so the pair does not shuffle
       sideways between one dialog and the next, or between English and Polish. Narrower than the panel's
       primary action, which is sized to be findable on a full screen rather than inside a 440 px box. -->
  <sys:Double x:Key="DialogButtonMinWidth">120</sys:Double>

  <sys:Double x:Key="TargetBoxMaxWidth">320</sys:Double>

  <!-- The scenario chips wrap inside this width. A cap is what MAKES them wrap: a WrapPanel measured with
       unbounded width lays every chip in one row, so without this the list grows sideways with the
       catalogue instead of down. -->
  <sys:Double x:Key="ScenarioListMaxWidth">560</sys:Double>

  <!-- The two launch fields (arguments, working folder) line up on one label column, so the boxes start at
       the same x whichever label is longer - including in Polish, where both labels are longer than in
       English. Named, because a hand-tuned margin per row drifts apart the first time a label changes. -->
  <sys:Double x:Key="LaunchLabelWidth">128</sys:Double>
  <sys:Double x:Key="LaunchFieldWidth">340</sys:Double>
  <sys:Double x:Key="LaunchNoteMaxWidth">480</sys:Double>

</ResourceDictionary>
