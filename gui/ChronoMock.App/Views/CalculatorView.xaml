<UserControl x:Class="ChronoMock.App.Views.CalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
  <!--
    Date-calculator screen (chrono-mock 7.3). Slice G3b: the builder (base, shift steps, calendar) and
    the result column are LIVE, evaluated through the calc engine via the calc client (ADR-6, one engine).
    The presets column and the reverse-analysis strip are still a static preview, wired in slices G4/G5.
    Only shift steps have an editor yet (snap / nearest / set-time / zone follow). Colours, spacing and
    type come from Themes, never literals (zasady/13); text chrome is translation keys (rule 15).
  -->
  <Grid Background="{DynamicResource BrushBgBase}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
      <Grid Margin="{StaticResource SpaceMd}" MinWidth="820">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="250" />
          <ColumnDefinition Width="*" MinWidth="300" />
          <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: tester presets. Static preview until slice G4 wires the shared catalogue. -->
        <Border Grid.Column="0" Margin="{StaticResource SpaceSm}" Padding="{StaticResource SpaceLg}"
                Background="{DynamicResource BrushBgSurface}" CornerRadius="{StaticResource RadiusMd}">
          <StackPanel>
            <TextBlock Text="{DynamicResource calc.presets_header}"
                       FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextSecondary}" Margin="{StaticResource SpaceXs}" />
            <ui:TextBox Margin="{StaticResource SpaceXs}"
                        PlaceholderText="{DynamicResource calc.filter_placeholder}" />
            <Button Margin="{StaticResource SpaceXs}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <StackPanel>
                <TextBlock Text="Quarter end" FontSize="{StaticResource FontSizeBody}"
                           Foreground="{DynamicResource BrushAccent}" />
                <TextBlock Text="last day of the quarter" FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushTextSecondary}" />
              </StackPanel>
            </Button>
            <Button Margin="{StaticResource SpaceXs}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <StackPanel>
                <TextBlock Text="Trial: last day" FontSize="{StaticResource FontSizeBody}"
                           Foreground="{DynamicResource BrushTextPrimary}" />
                <TextBlock Text="last moment of the trial" FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushTextSecondary}" />
              </StackPanel>
            </Button>
            <TextBlock Text="{DynamicResource calc.preset_note}" TextWrapping="Wrap"
                       Margin="{StaticResource SpaceXs}"
                       FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextSecondary}" />
          </StackPanel>
        </Border>

        <!-- MIDDLE: the live expression builder (base, shift steps, calendar). -->
        <Border Grid.Column="1" Margin="{StaticResource SpaceSm}" Padding="{StaticResource SpaceLg}"
                Background="{DynamicResource BrushBgSurface}" CornerRadius="{StaticResource RadiusMd}">
          <StackPanel>
            <TextBlock Text="{DynamicResource calc.build_header}"
                       FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextSecondary}" Margin="{StaticResource SpaceXs}" />

            <TextBlock Text="{DynamicResource calc.start_point}" Margin="{StaticResource SpaceXs}"
                       FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextSecondary}" />
            <StackPanel Orientation="Horizontal" Margin="{StaticResource SpaceXs}">
              <ComboBox ItemsSource="{Binding BaseKinds}" SelectedItem="{Binding SelectedBase}"
                        ItemContainerStyle="{StaticResource LabelKeyComboItem}" MinWidth="140">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding LabelKey, Converter={StaticResource KeyToText}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBox Text="{Binding BaseText, UpdateSourceTrigger=LostFocus}"
                       Width="200" Margin="{StaticResource SpaceSm}"
                       FontFamily="{StaticResource FontFamilyMono}"
                       Visibility="{Binding IsSpecificBase, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <TextBlock Text="{DynamicResource calc.steps_header}" Margin="{StaticResource SpaceXs}"
                       FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextSecondary}" />
            <ItemsControl ItemsSource="{Binding Steps}" Margin="{StaticResource SpaceXs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="{StaticResource SpaceXs}" Padding="{StaticResource SpaceSm}"
                          Background="{DynamicResource BrushBgSurfaceAlt}" CornerRadius="{StaticResource RadiusSm}">
                    <StackPanel Orientation="Horizontal">
                      <!-- Kind picker: swaps which editor to its right is visible. -->
                      <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"
                                ItemContainerStyle="{StaticResource LabelKeyComboItem}"
                                VerticalAlignment="Center" MinWidth="120">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding LabelKey, Converter={StaticResource KeyToText}}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>

                      <!-- Shift editor: sign, amount, unit. -->
                      <StackPanel Orientation="Horizontal"
                                  Visibility="{Binding IsShift, Converter={StaticResource BoolToVis}}">
                        <ComboBox ItemsSource="{Binding Signs}" SelectedItem="{Binding Sign}"
                                  Margin="{StaticResource SpaceSm}" VerticalAlignment="Center" MinWidth="48" />
                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=LostFocus}"
                                 Width="64" VerticalAlignment="Center"
                                 FontFamily="{StaticResource FontFamilyMono}" />
                        <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}"
                                  ItemContainerStyle="{StaticResource LabelKeyComboItem}"
                                  Margin="{StaticResource SpaceSm}" VerticalAlignment="Center" MinWidth="120">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding LabelKey, Converter={StaticResource KeyToText}}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>

                      <!-- Snap editor: a period boundary target. -->
                      <StackPanel Orientation="Horizontal"
                                  Visibility="{Binding IsSnap, Converter={StaticResource BoolToVis}}">
                        <ComboBox ItemsSource="{Binding SnapTargets}" SelectedItem="{Binding SnapTarget}"
                                  ItemContainerStyle="{StaticResource LabelKeyComboItem}"
                                  Margin="{StaticResource SpaceSm}" VerticalAlignment="Center" MinWidth="180">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding LabelKey, Converter={StaticResource KeyToText}}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>

                      <!-- Nearest editor: roll to the nearest business day in a direction (needs a calendar;
                           without one the engine returns an honest calendar error, surfaced as the result error). -->
                      <StackPanel Orientation="Horizontal"
                                  Visibility="{Binding IsNearest, Converter={StaticResource BoolToVis}}">
                        <ComboBox ItemsSource="{Binding NearestTargets}" SelectedItem="{Binding NearestTarget}"
                                  ItemContainerStyle="{StaticResource LabelKeyComboItem}"
                                  Margin="{StaticResource SpaceSm}" VerticalAlignment="Center" MinWidth="180">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding LabelKey, Converter={StaticResource KeyToText}}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>

                      <!-- Set-time editor: a wall-clock HH:MM:SS. The engine validates the range, so a bad
                           time surfaces as an honest result error rather than being clamped in the view. -->
                      <StackPanel Orientation="Horizontal"
                                  Visibility="{Binding IsSetTime, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding SetTimeText, UpdateSourceTrigger=LostFocus}"
                                 Width="96" Margin="{StaticResource SpaceSm}" VerticalAlignment="Center"
                                 FontFamily="{StaticResource FontFamilyMono}"
                                 AutomationProperties.Name="{DynamicResource calc.kind_settime}" />
                      </StackPanel>

                      <Button Content="✕" Click="OnRemoveStepClick" Tag="{Binding}"
                              Margin="{StaticResource SpaceSm}" VerticalAlignment="Center"
                              AutomationProperties.Name="{DynamicResource calc.remove_step}"
                              FontSize="{StaticResource FontSizeCaption}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="{DynamicResource calc.add_step}" Click="OnAddStepClick"
                    Margin="{StaticResource SpaceXs}" HorizontalAlignment="Left" />

            <StackPanel Orientation="Horizontal" Margin="{StaticResource SpaceMd}">
              <TextBlock Text="{DynamicResource calc.field_calendar}" VerticalAlignment="Center"
                         FontSize="{StaticResource FontSizeCaption}"
                         Foreground="{DynamicResource BrushTextSecondary}" />
              <ComboBox ItemsSource="{Binding Calendars}" SelectedItem="{Binding SelectedCalendar}"
                        ItemContainerStyle="{StaticResource LabelKeyComboItem}"
                        Margin="{StaticResource SpaceSm}" VerticalAlignment="Center" MinWidth="140">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding LabelKey, Converter={StaticResource KeyToText}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- RIGHT: the live result of evaluating the builder. -->
        <Border Grid.Column="2" Margin="{StaticResource SpaceSm}" Padding="{StaticResource SpaceLg}"
                Background="{DynamicResource BrushBgSurface}" CornerRadius="{StaticResource RadiusMd}">
          <StackPanel>
            <TextBlock Text="{DynamicResource calc.result_header}"
                       FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextSecondary}" Margin="{StaticResource SpaceXs}" />

            <TextBlock Margin="{StaticResource SpaceXs}" TextWrapping="Wrap"
                       FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}">
              <Run Text="{Binding ResultWeekday, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding ResultDate, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Margin="{StaticResource SpaceXs}"
                       FontFamily="{StaticResource FontFamilyMono}"
                       FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextSecondary}">
              <Run Text="{Binding ResultTime, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding ResultZone, Mode=OneWay}" />
            </TextBlock>

            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="{StaticResource SpaceXs}"
                       FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushStatusFails}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

            <Border Margin="{StaticResource SpaceMd}" Padding="{StaticResource SpaceMd}"
                    Background="{DynamicResource BrushBgBase}" CornerRadius="{StaticResource RadiusSm}"
                    Visibility="{Binding HasSignificance, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <TextBlock Text="{DynamicResource calc.what_tests}" FontSize="{StaticResource FontSizeCaption}"
                           FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" />
                <ItemsControl ItemsSource="{Binding Significance}" Margin="{StaticResource SpaceXs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={StaticResource KeyToText}}" TextWrapping="Wrap"
                                 FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <TextBlock Text="{DynamicResource calc.all_formats}" Margin="{StaticResource SpaceXs}"
                       FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextSecondary}" />
            <ItemsControl ItemsSource="{Binding Formats}" Margin="{StaticResource SpaceXs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="{StaticResource SpaceXs}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="86" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                               FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextSecondary}" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                               FontFamily="{StaticResource FontFamilyMono}"
                               FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextPrimary}" />
                    <Button Grid.Column="2" Content="{DynamicResource calc.copy}" Click="OnCopyFormatClick"
                            Tag="{Binding Value}" FontSize="{StaticResource FontSizeCaption}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{DynamicResource calc.metadata}" Margin="{StaticResource SpaceXs}"
                       FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextSecondary}" />
            <TextBlock Text="{Binding MetadataLine}" TextWrapping="Wrap" Margin="{StaticResource SpaceXs}"
                       FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextPrimary}" />

            <Button Content="{DynamicResource calc.use_in_substitution}" Margin="{StaticResource SpaceMd}"
                    HorizontalAlignment="Stretch" IsEnabled="False" />
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>

    <!-- BOTTOM: reverse analysis. Static preview until slice G5 wires it to the analyze mode. -->
    <Border Grid.Row="1" Margin="{StaticResource SpaceMd}" Padding="{StaticResource SpaceLg}"
            Background="{DynamicResource BrushBgSurface}" CornerRadius="{StaticResource RadiusMd}">
      <StackPanel>
        <TextBlock Text="{DynamicResource calc.reverse_header}"
                   FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushTextSecondary}" Margin="{StaticResource SpaceXs}" />
        <StackPanel Orientation="Horizontal">
          <TextBox Text="04/08/2008" Width="160" Margin="{StaticResource SpaceXs}"
                   FontFamily="{StaticResource FontFamilyMono}" IsEnabled="False" />
          <TextBlock Text="US → 2008-04-08 (Apr 8) · PL → 2008-08-04 (Aug 4)" VerticalAlignment="Center"
                     Margin="{StaticResource SpaceSm}"
                     FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushStatusPartial}" />
        </StackPanel>
        <TextBlock Text="{DynamicResource calc.preview_note}" Margin="{StaticResource SpaceXs}"
                   FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextSecondary}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
