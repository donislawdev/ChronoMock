<UserControl x:Class="ChronoMock.App.Views.CalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:ChronoMock.App"
             xmlns:controls="clr-namespace:ChronoMock.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Local merge so a {StaticResource ScenarioRow} resolves at this control's BAML load: a keyed
             StaticResource never reaches Application.Resources, only implicit styles and DynamicResource do
             (see App.xaml). The phase views merge Parts.xaml the same way and must. -->
        <ResourceDictionary Source="../Themes/Parts.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <!--
    Date-calculator screen (chrono-mock 7.3). Slice G3b: the builder (base, shift steps, calendar) and
    the result column are LIVE, evaluated through the calc engine via the calc client (ADR-6, one engine).
    The presets column and the reverse-analysis strip are LIVE too: selecting a preset fills the builder,
    and a pasted date resolves through reverse analysis.
    Only shift steps have an editor yet (snap / nearest / set-time / zone follow). Colours, spacing and
    type come from Themes, never literals (zasady/13); text chrome is translation keys (rule 15).
  -->
  <Grid Background="{DynamicResource BrushBgBase}">
    <!--
      🔴 EACH COLUMN SCROLLS ON ITS OWN, and the outer viewer no longer scrolls vertically. One
      shared scroller for three columns of very different heights meant the tallest one decided for
      everybody: measured at 1560 x 1200, the preset list ran 938 px below the bottom of the window,
      so reaching the last preset pushed the result and the builder off the screen even though both
      fit. What the user saw was the top of everything and the bottom of nothing.

      The widths are proportions with a floor rather than fixed numbers. Two of the three columns
      used to be pinned (250 and 320), so every extra pixel of a wide window went to the middle one -
      the emptiest - while the result column stayed at 320 whatever the window did, which is why a
      FILETIME broke in the middle of its digits. Now all three grow.

      🔴 THERE IS NO SCROLLER AROUND THESE COLUMNS, and that is the point rather than an omission.
      A ScrollViewer that offers horizontal scrolling measures its child at INFINITE width, and a
      star column measured against infinity has no share to take, so it degenerates to its content
      width. Measured while building this: with the old outer scroller kept, the presets column grew
      to about 1250 px and the result column left the window entirely. Binding the grid to the
      viewport instead still left it 12 px too wide, which clipped the copy buttons. A grid sitting
      directly in the row has a real width to divide and none of that happens.

      What that costs is a floor: three columns do not fit in a narrow window, so the window carries
      a MinWidth that matches these three. That is an honest constraint rather than a scrollbar
      apologising for a layout that cannot fit.
    -->
    <Grid Margin="{StaticResource SpaceMd}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" MinWidth="{StaticResource CalcScenariosColumnMinWidth}" />
        <ColumnDefinition Width="1.15*" MinWidth="{StaticResource CalcBuilderColumnMinWidth}" />
        <ColumnDefinition Width="1.1*" MinWidth="{StaticResource CalcResultColumnMinWidth}" />
      </Grid.ColumnDefinitions>

      <!-- LEFT: tester presets from the shared catalogue (7.3). Filterable - each row shows the localized
           name and what the date tests. Clicking a row to fill the builder is wired in slice G4-1b. -->
      <Border Grid.Column="0" Margin="{StaticResource SpaceSm}" Padding="{StaticResource SpaceLg}"
              Background="{DynamicResource BrushBgSurface}" CornerRadius="{StaticResource RadiusMd}">
        <!-- The filter heads the list and the note sits under it, both Auto, so neither is ever scrolled off.
             The list height itself is explained above the ListBox below. -->
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Style="{StaticResource PartGroupHeading}" Grid.Row="0" Text="{DynamicResource calc.presets_header}" Margin="{StaticResource SpaceXs}" />
          <TextBox Grid.Row="1" x:Name="PresetFilterBox" Margin="{StaticResource SpaceXs}"
                   Text="{Binding PresetFilter, UpdateSourceTrigger=PropertyChanged}"
                   app:PartState.Placeholder="{DynamicResource calc.filter_placeholder}" />
          <!-- 🔴 A ListBox with the SHARED ScenarioRow, so the preset list reads exactly like the
               scenario list in the setup phase (GUI rules 2 and 5) - it used to be a stack of heavy
               buttons. Selecting a row fills the builder through SelectedPreset (fill-on-select is safe:
               unpacking a preset is exempt from the by-hand-edit clear, guarded in the view model). -->
          <!-- 🔴 THE WELL FITS ITS CONTENT, capped at the column, rather than always filling it. A * row made
               the bordered well as tall as the column, so a short catalogue sat in a large box of empty dark
               - the fault this replaces. Height Auto overrides the fixed well height and sizes it to its
               rows, VerticalAlignment Top holds it at the top, and MaxHeight bound to this cell caps it at
               the column so a long catalogue scrolls inside instead of overflowing. The filter above stays
               put, and the space under a short list is plain card, not a bordered empty box. -->
          <Grid Grid.Row="2" x:Name="ListArea">
            <ListBox x:Name="PresetList" ItemsSource="{Binding Presets}"
                     SelectedItem="{Binding SelectedPreset}"
                     ItemTemplate="{StaticResource ScenarioRow}"
                     ItemContainerStyle="{StaticResource ScenarioRowContainer}"
                     VerticalAlignment="Top" Height="Auto"
                     MaxHeight="{Binding ActualHeight, ElementName=ListArea}"
                     Margin="{StaticResource SpaceXs}" />
          </Grid>
          <TextBlock Grid.Row="3" Text="{DynamicResource calc.preset_note}" TextWrapping="Wrap"
                     Margin="{StaticResource SpaceXs}"
                     FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextSecondary}" />
        </Grid>
      </Border>

      <!-- MIDDLE: the live expression builder (base, shift steps, calendar). -->
      <Border Grid.Column="1" Margin="{StaticResource SpaceSm}" Padding="{StaticResource CardPaddingScrolled}"
              Background="{DynamicResource BrushBgSurface}" CornerRadius="{StaticResource RadiusMd}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="{StaticResource ScrollGutter}">
          <StackPanel>
            <TextBlock Style="{StaticResource PartGroupHeading}" Text="{DynamicResource calc.build_header}" />

            <!-- 🔴 ONE LEFT EDGE. Every field in this column stacks under its own label and starts on
                 the column's edge: no label column, no per-control margins. The column is too narrow
                 for a label beside a date-and-time row (the row alone is wider than what a label column
                 leaves it), and a mix of "label beside" and "label above" gave the owner's review of the
                 shipped build a builder whose fields looked randomly placed - three different x for four
                 controls, measured on the render (2026-09-21). Stacking is the layout RULE here, and the
                 column's minimum width is derived from the widest row it holds (CalcBuilderColumnMinWidth),
                 so the date and the time stay on one line rather than being fitted by hand. -->
            <TextBlock Style="{StaticResource PartFieldLabel}" Text="{DynamicResource calc.start_point}" />
            <ComboBox x:Name="BaseKindBox" ItemsSource="{Binding BaseKinds}" SelectedItem="{Binding SelectedBase}"
                      ItemContainerStyle="{StaticResource LabelKeyComboItem}"
                      ToolTip="{DynamicResource tip.base_kind}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding LabelKey, Converter={StaticResource KeyToText}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- Specific date: the shared moment input (ISO box plus a calendar popup, locale-safe, rule 2),
                 the same control the substitution panel uses. Its DataContext is the base MomentField, so
                 Visibility binds to the view model through the CalculatorView, not the field. -->
            <controls:MomentInput x:Name="BaseMoment" DataContext="{Binding Base}"
                                  Margin="{StaticResource StackGapSm}" HorizontalAlignment="Left"
                                  Visibility="{Binding DataContext.IsSpecificBase, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVis}}" />
            <!-- Validation message BELOW the start-point row (only for a malformed Specific base), so it never
                 shifts the row - mirrors the substitution At row. -->
            <TextBlock Style="{StaticResource PartFieldMessage}" Margin="{StaticResource StackGapSm}"
                       Text="{Binding Base.ActiveErrorKey, Converter={StaticResource KeyToText}}"
                       Visibility="{Binding ShowBaseError, Converter={StaticResource BoolToVis}}" />

            <!-- The SESSION zone the start point is read in (engine flag: zone). The step list below offers
                 a "to zone" step that means the opposite direction - re-express the ANSWER, not read the
                 base. Same closed catalogue and same item template as the substitution panel, so one idea
                 has one idiom. The first entry is the host, which sends no flag at all: that is what this
                 panel always did, so the default changes no result, it only says out loud which zone it was
                 (rule 2). Full width, because the longest gloss - "UTC+00:00 · Coordinated Universal Time" -
                 clipped in anything narrower, in the closed box and in the drop-down that borrows its width. -->
            <TextBlock Style="{StaticResource PartFieldLabel}" Text="{DynamicResource calc.base_zone}" />
            <ComboBox x:Name="BaseZoneBox" ItemsSource="{Binding BaseZones}" SelectedItem="{Binding SelectedBaseZone}"
                      ToolTip="{DynamicResource tip.base_zone}"
                      ItemContainerStyle="{StaticResource ZoneComboItem}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock><Run Text="{Binding Label, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding HintKey, Converter={StaticResource KeyToText}, Mode=OneWay}" /></TextBlock>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Style="{StaticResource PartFieldLabel}" Text="{DynamicResource calc.steps_header}" />
            <ItemsControl ItemsSource="{Binding Steps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="{StaticResource StackGapSm}" Padding="{StaticResource SpaceSm}"
                          Background="{DynamicResource BrushBgSurfaceAlt}" CornerRadius="{StaticResource RadiusSm}">
                    <!-- 🔴 TWO ROWS AND A GRID, not one horizontal stack: a horizontal stack hands every
                         child its full desired width and lets the overflow run past its container.
                         Measured before the change, on the default 1040 window: the row wanted 439 px
                         where the column had 331, so the unit list ended mid word and the remove button
                         was laid out 108 px past the column, UNDER the opaque result panel. It was not
                         merely ugly - a step could be added and then not removed, since the only control
                         that removes one was never painted.

                         The kind picker heads the step and the editor sits under it, which fits at the
                         window's own minimum and leaves the editors room to grow. The remove button spans
                         both rows because it removes the STEP, not the row it happens to sit on. The
                         multi-control editors keep a WrapPanel as the floor: a longer label in another
                         language then wraps instead of clipping. Widths are the tokens the setup's "From
                         now" row uses for the same three controls, so the two shift editors are one drawing. -->
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <!-- Kind picker: swaps which editor below it is visible. -->
                      <ComboBox Grid.Row="0" Grid.Column="0" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"
                                ItemContainerStyle="{StaticResource LabelKeyComboItem}" Margin="{StaticResource CopyValueGap}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding LabelKey, Converter={StaticResource KeyToText}}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>

                      <Button Grid.Row="0" Grid.Column="1" Content="✕" Click="OnRemoveStepClick" Tag="{Binding}"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="{DynamicResource calc.remove_step}"
                              FontSize="{StaticResource FontSizeCaption}" />

                      <!-- Shift editor: sign, amount, unit. -->
                      <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="{StaticResource StackGapSm}"
                                 Visibility="{Binding IsShift, Converter={StaticResource BoolToVis}}">
                        <ComboBox ItemsSource="{Binding Signs}" SelectedItem="{Binding Sign}"
                                  Width="{StaticResource ShiftSignWidth}" Margin="{StaticResource ControlRowGap}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=LostFocus}"
                                 Width="{StaticResource ShiftAmountWidth}" Margin="{StaticResource ControlRowGap}" VerticalAlignment="Center"
                                 FontFamily="{StaticResource FontFamilyMono}" />
                        <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}"
                                  ItemContainerStyle="{StaticResource LabelKeyComboItem}"
                                  Width="{StaticResource ShiftUnitWidth}" Margin="{StaticResource ControlRowGap}" VerticalAlignment="Center">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding LabelKey, Converter={StaticResource KeyToText}}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </WrapPanel>

                      <!-- Snap editor: a period boundary target. One control, so it takes the row. -->
                      <ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="{StaticResource StackGapSm}"
                                ItemsSource="{Binding SnapTargets}" SelectedItem="{Binding SnapTarget}"
                                ItemContainerStyle="{StaticResource LabelKeyComboItem}"
                                Visibility="{Binding IsSnap, Converter={StaticResource BoolToVis}}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding LabelKey, Converter={StaticResource KeyToText}}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>

                      <!-- Nearest editor: roll to the nearest business day in a direction (needs a calendar -
                           without one the engine returns an honest calendar error, surfaced as the result error). -->
                      <ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="{StaticResource StackGapSm}"
                                ItemsSource="{Binding NearestTargets}" SelectedItem="{Binding NearestTarget}"
                                ItemContainerStyle="{StaticResource LabelKeyComboItem}"
                                Visibility="{Binding IsNearest, Converter={StaticResource BoolToVis}}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding LabelKey, Converter={StaticResource KeyToText}}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>

                      <!-- Set-time editor: a wall-clock HH:MM:SS, the width the time field has everywhere
                           else. The engine validates the range, so a bad time surfaces as an honest result
                           error rather than being clamped in the view. -->
                      <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="{StaticResource StackGapSm}"
                               Text="{Binding SetTimeText, UpdateSourceTrigger=LostFocus}"
                               Width="{StaticResource MomentTimeFieldWidth}" HorizontalAlignment="Left"
                               FontFamily="{StaticResource FontFamilyMono}"
                               AutomationProperties.Name="{DynamicResource calc.kind_settime}"
                               Visibility="{Binding IsSetTime, Converter={StaticResource BoolToVis}}" />

                      <!-- Zone editor: a fixed offset +HH:MM for the to-zone step - the same instant
                           re-expressed in another zone, NOT the session zone. Engine validates the shape. -->
                      <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="{StaticResource StackGapSm}"
                               Text="{Binding ZoneText, UpdateSourceTrigger=LostFocus}"
                               Width="{StaticResource OffsetFieldWidth}" HorizontalAlignment="Left"
                               FontFamily="{StaticResource FontFamilyMono}"
                               AutomationProperties.Name="{DynamicResource calc.kind_zone}"
                               Visibility="{Binding IsZone, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="AddStepButton" Content="{DynamicResource calc.add_step}" Click="OnAddStepClick"
                    ToolTip="{DynamicResource tip.add_step}"
                    Margin="{StaticResource StackGapSm}" HorizontalAlignment="Left" />

            <!-- The calendar that judges business days. The engine refuses a business-day step when no
                 calendar is picked, and the picker is in this column while the refusal is read in the
                 other one, so the field says so itself: the shared error edge, the same one a text field
                 shows, bound to the flag the result sentence is bound to. The edge only changes colour, so
                 turning it on never moves the row. -->
            <TextBlock Style="{StaticResource PartFieldLabel}" Text="{DynamicResource calc.field_calendar}" />
            <ComboBox x:Name="CalendarBox" ItemsSource="{Binding Calendars}" SelectedItem="{Binding SelectedCalendar}"
                      ItemContainerStyle="{StaticResource LabelKeyComboItem}" ToolTip="{DynamicResource tip.calc_calendar}"
                      app:PartState.HasError="{Binding CalendarMissing}"
                      AutomationProperties.Name="{DynamicResource calc.field_calendar}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding LabelKey, Converter={StaticResource KeyToText}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- The reverse tool lives here now, under the builder, so the middle column carries both ways
                 of naming a moment - build one up, or read a pasted one - instead of a short form standing
                 over a long void. Paste a date and see how it reads, with both interpretations when the
                 numeric order is ambiguous (04/08 is April 8 in the US, August 4 in Poland). The readings
                 stack the label over the value rather than sitting beside it: this column is narrower than
                 the old full-width strip, and "US reading (MM/DD/YYYY)" beside its value would run past the
                 column edge - the very fault the builder rows above already had to fix. -->
            <StackPanel Margin="{StaticResource StackGapXl}">
              <TextBlock Style="{StaticResource PartGroupHeading}" Text="{DynamicResource calc.reverse_header}" />
              <!-- Full width and on the column's edge, like every field above it: it stood 4 px in from
                   the builder's fields at a width of its own, which is the "randomly placed" the owner's
                   review named. A pasted date is short, but a field narrower than its column has no
                   reason to be, and the same edge is the point. -->
              <TextBox x:Name="AnalyzeBox" Text="{Binding AnalyzeText, UpdateSourceTrigger=LostFocus}"
                       Margin="{StaticResource StackGapSm}"
                       FontFamily="{StaticResource FontFamilyMono}" ToolTip="{DynamicResource tip.analyze}"
                       AutomationProperties.Name="{DynamicResource calc.reverse_header}" />
              <TextBlock Text="{DynamicResource calc.analyze_ambiguous}" TextWrapping="Wrap" Margin="{StaticResource StackGapSm}"
                         FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushStatusPartial}"
                         Visibility="{Binding AnalyzeAmbiguous, Converter={StaticResource BoolToVis}}" />
              <TextBlock Text="{Binding AnalyzeError}" TextWrapping="Wrap" Margin="{StaticResource StackGapSm}"
                         FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushStatusFails}"
                         Visibility="{Binding AnalyzeHasError, Converter={StaticResource BoolToVis}}" />
              <ItemsControl ItemsSource="{Binding Readings}" Margin="{StaticResource StackGapSm}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="{StaticResource StackGapSm}">
                      <TextBlock Text="{Binding ReadingLabelKey, Converter={StaticResource KeyToText}}" TextWrapping="Wrap"
                                 FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextSecondary}" />
                      <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}"><Run Text="{Binding WeekdayKey, Converter={StaticResource KeyToText}, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Date, Mode=OneWay}" /></TextBlock>
                        <ItemsControl ItemsSource="{Binding Significance}" VerticalAlignment="Center" Margin="{StaticResource SpaceSm}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Converter={StaticResource KeyToText}}" Margin="{StaticResource SpaceXs}"
                                         FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushAccent}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- RIGHT: the live result of evaluating the builder. -->
      <Border Grid.Column="2" Margin="{StaticResource SpaceSm}" Padding="{StaticResource CardPaddingScrolled}"
              Background="{DynamicResource BrushBgSurface}" CornerRadius="{StaticResource RadiusMd}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="{StaticResource ScrollGutter}">
          <StackPanel>
            <TextBlock Style="{StaticResource PartGroupHeading}" Text="{DynamicResource calc.result_header}" Margin="{StaticResource SpaceXs}" />

            <!-- Active preset provenance (7.3): the authored name and "what it tests", plus an honest note
                 when the preset needs parameters (it does not fill the builder then). Cleared on a by-hand edit. -->
            <Border Margin="{StaticResource SpaceXs}" Padding="{StaticResource SpaceSm}"
                    Background="{DynamicResource BrushBgBase}" CornerRadius="{StaticResource RadiusSm}"
                    Visibility="{Binding HasActivePreset, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <TextBlock Text="{Binding ActivePresetName}" TextWrapping="Wrap"
                           FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushAccent}" />
                <TextBlock Text="{Binding ActivePresetExplains}" TextWrapping="Wrap"
                           FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextSecondary}" />

                <!-- Parameter inputs (docs/04 4.2): a date box or an amount+unit per parameter, seeded from
                     the file defaults. Filling a required date recomputes the result. -->
                <StackPanel Margin="{StaticResource SpaceXs}"
                            Visibility="{Binding HasParamInputs, Converter={StaticResource BoolToVis}}">
                  <TextBlock Style="{StaticResource PartGroupHeading}" Text="{DynamicResource calc.preset_params_header}" />
                  <ItemsControl ItemsSource="{Binding ParamInputs}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource SpaceXs}">
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" MinWidth="90"
                                     FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextSecondary}" />
                          <!-- The shared date input, calendar included: a date the setup and the builder let
                               the tester pick was typed by hand here, and a first run read the missing
                               calendar as this one being broken (owner's review, 2026-09-21). -->
                          <controls:DateInput VerticalAlignment="Center"
                                              AccessibleName="{Binding Label}"
                                              Visibility="{Binding IsDate, Converter={StaticResource BoolToVis}}" />
                          <StackPanel Orientation="Horizontal"
                                      Visibility="{Binding IsDuration, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding Amount, UpdateSourceTrigger=LostFocus}"
                                     Width="56" VerticalAlignment="Center" FontFamily="{StaticResource FontFamilyMono}"
                                     AutomationProperties.Name="{Binding Label}" />
                            <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}"
                                      ItemContainerStyle="{StaticResource LabelKeyComboItem}"
                                      Margin="{StaticResource SpaceSm}" VerticalAlignment="Center" MinWidth="110">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding LabelKey, Converter={StaticResource KeyToText}}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                          <ComboBox ItemsSource="{Binding VariantOptions}" SelectedItem="{Binding Variant}"
                                    ItemContainerStyle="{StaticResource LabelKeyComboItem}"
                                    VerticalAlignment="Center" MinWidth="150"
                                    AutomationProperties.Name="{Binding Label}"
                                    Visibility="{Binding IsVariant, Converter={StaticResource BoolToVis}}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding LabelKey, Converter={StaticResource KeyToText}}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <TextBlock Text="{DynamicResource calc.preset_needs_params}" TextWrapping="Wrap"
                           Margin="{StaticResource SpaceXs}"
                           FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushStatusPartial}"
                           Visibility="{Binding ActiveNeedsParameters, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
            </Border>

            <TextBlock Margin="{StaticResource SpaceXs}" TextWrapping="Wrap"
                       FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}">
              <Run Text="{Binding ResultWeekday, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding ResultDate, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Margin="{StaticResource SpaceXs}"
                       FontFamily="{StaticResource FontFamilyMono}"
                       FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextSecondary}">
              <Run Text="{Binding ResultTime, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding ResultZone, Mode=OneWay}" />
            </TextBlock>

            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="{StaticResource SpaceXs}"
                       FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushStatusFails}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
            <!-- The engine's own sentence, UNDER the translated message: it names a step number or a year
                 range that the key alone does not carry. Quieter than the line above, because it is the
                 detail, not the answer. -->
            <TextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap" Margin="{StaticResource SpaceXs}"
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       Visibility="{Binding HasErrorDetail, Converter={StaticResource BoolToVis}}" />

            <Border Margin="{StaticResource SpaceMd}" Padding="{StaticResource SpaceMd}"
                    Background="{DynamicResource BrushBgBase}" CornerRadius="{StaticResource RadiusSm}"
                    Visibility="{Binding HasSignificance, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <TextBlock Text="{DynamicResource calc.what_tests}" FontSize="{StaticResource FontSizeCaption}"
                           FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" />
                <ItemsControl ItemsSource="{Binding Significance}" Margin="{StaticResource SpaceXs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={StaticResource KeyToText}}" TextWrapping="Wrap"
                                 FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Which calendar judged the weekend and holiday marks above. It belongs HERE and not
                     only beside the picker: the picker is in the middle column and this is read in the
                     right one, so a line saying "weekend - not a business day" would otherwise be a
                     calendar-dependent judgement with its calendar nowhere in sight. -->
                <TextBlock Text="{Binding SignificanceCalendar}" TextWrapping="Wrap"
                           Visibility="{Binding HasSignificanceCalendar, Converter={StaticResource BoolToVis}}"
                           Margin="{StaticResource SpaceXs}"
                           FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextSecondary}" />
              </StackPanel>
            </Border>

            <!-- Why a day in the result is not the day that was typed: a month-folding shift landed in
                 a shorter month (31 January + 1 month = 28 February). Correct and documented, and
                 otherwise invisible here, since this window shows no intermediate steps - the reader
                 would see a changed day with no reason and could not tell the rule from a defect. -->
            <TextBlock Text="{Binding ClampNotice}" TextWrapping="Wrap"
                       Visibility="{Binding HasClampNotice, Converter={StaticResource BoolToVis}}"
                       Margin="{StaticResource SpaceXs}"
                       FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushStatusPartial}" />

            <TextBlock Style="{StaticResource PartGroupHeading}" Text="{DynamicResource calc.all_formats}" Margin="{StaticResource SpaceXs}" />
            <ItemsControl x:Name="FormatList" ItemsSource="{Binding Formats}" Margin="{StaticResource SpaceXs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="{StaticResource SpaceXs}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="104" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                               FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextSecondary}" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                               Margin="{StaticResource CopyValueGap}"
                               FontFamily="{StaticResource FontFamilyMono}"
                               FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextPrimary}" />
                    <Button Grid.Column="2" Content="{DynamicResource calc.copy}" Click="OnCopyFormatClick"
                            Tag="{Binding Value}" MinWidth="{StaticResource CopyButtonMinWidth}"
                            FontSize="{StaticResource FontSizeCaption}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Custom output format (7.3): a .NET/Java-token mask so the tester can hit the exact string the
                 tested app's field expects. Built from the civil date, so it renders even when epoch/FILETIME
                 are out of range. An empty mask hides the result row (no format flag is sent). -->
            <TextBlock Style="{StaticResource PartGroupHeading}" Text="{DynamicResource calc.custom_format}" Margin="{StaticResource SpaceXs}" />
            <!-- PropertyChanged, unlike every other text field here, and the reason is this field's
                 position: it is the last control in the result column, so there is nothing to move on
                 to, and on LostFocus the mask reached the view model only if the tester happened to
                 click elsewhere. Measured on the running window: the mask sat in the box and the result
                 row stayed absent until focus left. A partly typed mask is always a valid mask (an
                 unknown token run is passed through as text and reported, never a failure), so every intermediate state is
                 a meaningful preview rather than an error flash, and the 250 ms quiet period in the
                 setter still costs one evaluation per pause, not one per keystroke. -->
            <TextBox x:Name="CustomFormatBox" Margin="{StaticResource SpaceXs}" FontFamily="{StaticResource FontFamilyMono}"
                     Text="{Binding CustomFormatMask, UpdateSourceTrigger=PropertyChanged}"
                     app:PartState.Placeholder="{DynamicResource calc.custom_format_hint}"
                     ToolTip="{DynamicResource tip.custom_format}"
                     AutomationProperties.Name="{DynamicResource calc.custom_format}" />
            <Grid Margin="{StaticResource SpaceXs}"
                  Visibility="{Binding HasCustomFormat, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding CustomFormatResult}" TextWrapping="Wrap"
                         Margin="{StaticResource CopyValueGap}"
                         FontFamily="{StaticResource FontFamilyMono}"
                         FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextPrimary}" />
              <Button Grid.Column="1" Content="{DynamicResource calc.copy}" Click="OnCopyFormatClick"
                      Tag="{Binding CustomFormatResult}" MinWidth="{StaticResource CopyButtonMinWidth}"
                      FontSize="{StaticResource FontSizeCaption}" />
            </Grid>
            <!-- Why the line above may not be what the reader expects: letter runs the engine does not
                 know are passed through as text, so the result LOOKS formatted while carrying raw mask
                 letters. Below the row, mirroring the base validation message, so it never shifts it. -->
            <TextBlock Text="{Binding CustomFormatWarning}"
                       Visibility="{Binding HasCustomFormatWarning, Converter={StaticResource BoolToVis}}"
                       Margin="{StaticResource SpaceXs}" TextWrapping="Wrap"
                       FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushStatusPartial}" />

            <TextBlock Style="{StaticResource PartGroupHeading}" Text="{DynamicResource calc.metadata}" Margin="{StaticResource SpaceXs}" />
            <TextBlock Text="{Binding MetadataLine}" TextWrapping="Wrap" Margin="{StaticResource SpaceXs}"
                       FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource BrushTextPrimary}" />

            <!-- The one action this module ends in, styled as the setup's Start is: it read as any other
                 button, and the owner's review of the shipped build could not find it (2026-09-21). -->
            <Button x:Name="UseInSubstitutionButton" Style="{StaticResource PartPrimaryAction}"
                    Content="{DynamicResource calc.use_in_substitution}" Margin="{StaticResource SpaceMd}"
                    HorizontalAlignment="Stretch" Click="OnUseInSubstitutionClick"
                    ToolTip="{DynamicResource tip.use_in_substitution}"
                    ToolTipService.ShowOnDisabled="True"
                    IsEnabled="{Binding CanUseInSubstitution}" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
