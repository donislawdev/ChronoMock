  // The browser a Chromium session drove (R5-D44), under the application, where the CLI report names it.
  "report.browser": "browser",
  // Every error the core sent, under the verdict, as the CLI report lists them (R5-D71).
  "report.errors": "errors",

  // The target's own exit code (informational; native sessions where the app exited on its own) and any cleanup residue the core could not remove - both surfaced from `ended` so a session never hides them.
  "report.target_exit": "application exited with code",
  "report.cleanup": "not fully cleaned up",
  // The processes the session went on for after the target closed (ADR-16), under the exit line, in the CLI report's words. "Went on for", never "until they closed": a Stop can end the session while one still runs.
  "report.followed": "the application had started these, and the session went on for them",
  "report.copies_outside": "the program most likely passed its work to these copies of it, running outside the session on the real clock",
  // What a refusal could not end (R4-S5), under the verdict in the copied summary, in the CLI report's words.
  "report.left_running": "could not be ended - they run on the real clock",
  // The processes the hook never got into, one line per pid the way the CLI report prints them (the screen
  // groups them - the clipboard keeps the pids). The role line is its own template so a translator never
  // assembles a sentence around an optional word.
  "report.processes_uncovered": "processes that ran on the real clock",
  "report.process_line": "pid {0}: {1}, spawned by pid {2}",
  "report.process_line_role": "pid {0}: {1} ({2}), spawned by pid {3}",
  "report.processes_more": "and {0} more this report could not name",
  // The engine lines of the copied summary. The pid is here and not on the screen: a ticket about one
