  "calc.err.bad_argument": "A step has a value the calculator cannot read. A shift must be a whole number with no sign (the direction is picked beside it), a time must be HH:MM:SS, and a time zone must be +HH:MM or -HH:MM, from -14:59 to +14:59.",
  "calc.err.analyze_unrecognized": "This is not a date format the analyser recognises. It reads ISO (2026-01-31), numeric dates with a four-digit year (01/31/2026), and a bare number as a Unix timestamp.",
  "calc.err.preset_not_for_calculator": "This scenario describes a session to run, not a date to compute.",
  "calc.err.calendar_not_found": "The chosen holiday calendar cannot be found - the installation may be incomplete, or its file was renamed or removed.",
