// English interface strings. Keys are stable and English, values are the display text.
// A new language is a copy of this file named Strings.<culture>.json with the values
// translated - no recompile (untouchable rule 15). JSON with // comments: this file is
// DATA, read as data. It used to be XAML parsed by XamlReader, which instantiates types
// and therefore ran as code - a loose file next to the exe must never be able to do that.
{

  // The window title and the title bar. {0} is the product version, filled in at startup from the
  // running build - the number is never written here, so there is nothing extra to bump. A
  // translation that drops {0} gets a title without a version rather than an error.
  "app.title": "Chrono Mock {0}",

  // Clock roles.
  "clock.fake": "Fake clock",
  "clock.real": "Real clock",
  // 🔴 How much time PASSED on that clock, which is the multiplier as a fact rather than a number to
  // trust. A label, because a bare duration beside a wall reading is two numbers and no way to tell
  // them apart.
  "clock.elapsed": "elapsed",

  // Target selection (chrono-mock 7.1). The dialog strings are keyed too (rule 15).
  "target.label": "Target:",
  "target.dialog_title": "Choose target",

  // Only .exe: native injection needs a PE and CDP needs an Electron/Chromium .exe. Narrowing the filter keeps a user from picking a .lnk/.bat/.txt that could only fail (RELEASE-007).
  "target.dialog_filter": "Executables (*.exe)|*.exe",

  // Scenarios (chrono-mock 7.1 pt 2): named moments from the shared preset catalogue. The scenario NAMES and their "what this date tests" lines come from the catalogue files (data locales), not from here.
  "scenario.label": "Scenario",
  "scenario.needs_parameters": "more scenarios take parameters - build one in the calculator, then use “Use this date”.",
  "scenario.failed": "That scenario could not be turned into a date.",
  "scenario.unsupported": "That scenario's preset file is in a shape this build cannot read.",
  "scenario.engine_missing": "The calculator engine could not be run, so scenarios cannot be computed.",

  // The list is searched rather than scanned, because the catalogue is meant to grow. Nothing matched and
  // nothing installed are opposite problems, so they get different sentences - and the first one says what
  // to do about it, never only that something is wrong.
  "scenario.filter_placeholder": "Search scenarios",
  "scenario.no_matches": "No scenario matches that. Clear the box to see them all.",
  "scenario.clear_filter": "Clear search",

  // The rebuilt setup screen: one thing always visible and the rest folded away behind a header that keeps
  // saying what is set inside it. The chips are deliberately short - they sit in a section header beside a
  // speed, where a full sentence would push the speed off the end.
  // 🔴 One line saying what the screen does and what it will not do, because somebody opening this for
  // the first time has no way of knowing either. The second half is the product's whole promise
  // (untouchable rule 1) and the question a stranger actually has: is this going to change my computer.
  "setup.intro": "Runs an application as if it were another date and time. The real system clock is never changed.",

  // "Moment" is our word, not the reader's.
  "setup.section_moment": "Date and time",
  "setup.section_speed": "Speed and options",
  // 🔴 The catalogue is its own group now, and folded. Measured at the window's real height: the moment
  // section was 603 px of a 671 px viewport because the catalogue lived inside it, so the two groups
  // under it were not merely below the fold - they were invisible on a first run, which is the fault this
  // rework exists to remove, in a new shape.
  "setup.section_scenario": "Scenarios",
  // A label and a value, so the count is grammatical whatever it is. "16 ready-made dates" reads well
  // and "1 ready-made dates" does not, and a summary is not the place to start pluralising in two
  // languages.
  "setup.scenario_available": "ready-made dates:",
  "setup.needs_target": "Choose an application before starting.",
  // 🔴 The other two refusals, which the footer had no words for. It said why Start was disabled only
  // when no application had been chosen - so a picked application plus an unreadable date left a dead
  // button with no account of itself, and at the window's floor the field's own message is off-screen.
  // These point at the field rather than repeating its message: the field says WHAT is wrong, this says
  // where to go and that it is what is holding Start.
  "setup.needs_moment": "Fix the date and time above before starting.",
  // 🔴 The session phase's own keys, in its own namespace, for the same reason the setup phase has its:
  // every key shared with the shipped panel moves that panel's pixels, and these go with the old screen
  // when the product adopts the parts library.
  // 🔴 The question, not our word for asking it. "Audit" is the mechanism's name for this block and
  // the reader has one question it answers - the same reason the four headers inside it stopped
  // saying "covered channel".
  "session.section_audit": "What the application read",
  "session.label_jump": "Jump",
  "session.jump_note": "The duration clock never goes backwards, even on a backward jump.",
  "session.label_jump_to": "Jump to",
  "session.action_jump_to": "Jump",
  // One word for one idea: the row says Speed and so does the tooltip, so the box does too.
  "session.rate_placeholder": "any speed",
  // 🔴 Application, not Running. The line outlives the run - the same screen shows a session that has
  // ended - and "Running:" stood above "Session ended" there.
  "session.application_label": "Application:",
  "session.stop_note": "Stopping returns the application to the real clock. It is not closed.",
  // Without "audit" and "core", the two mechanism words this screen stopped using everywhere else.
  "session.audit_pending": "The clocks this application reads will be listed here once the tool has checked.",
  // When the session is over and no report came, the sentence above would be a promise nobody keeps.
  "session.audit_never_arrived": "The session ended before the tool could check which clocks this application reads.",
  // And when there was no session at all - a start that failed before the first heartbeat. The sentence
  // above says "the session ended", which is false of a session that never began.
  "session.audit_never_started": "The application was never started under the fake clock, so there was nothing to check.",
  // A label and a number, for the reason setup.scenario_available gives: "1 warnings" was on this header.
  "session.chip_covered": "fake clock:",
  "session.chip_uncovered": "real clock:",
  "session.chip_unobserved": "could not be watched:",
  "session.chip_warnings": "warnings:",
  "setup.already_running": "A session is already running.",
  "setup.chip_duration": "duration scaled",
  "setup.chip_qpc": "QPC scaled",
  "setup.chip_force": "forced start",
  "setup.chip_no_embedded": "web pages not reached",
  // The launch fields moved into this section, so its folded header says they are set without printing
  // values that have no length limit.
  "setup.chip_args": "arguments set",
  "setup.chip_cwd": "folder set",
  // The contract sentence above Start names the CLOCK - the instant and the rate. The options are how the
  // rate is delivered rather than what the application sees, so they stay in the section header and the
  // sentence does not repeat them.
  // 🔴 A label, not a preposition. "running at ×60" reads well and "running at Flowing" does not, and the
  // mode list holds both kinds of value - a rate and a manner. A label and a value is grammatical
  // whatever the list is asked to hold next.
  "setup.contract_speed": "speed:",

  // 🔴 The form labels again, without their trailing colons. A colon separates a label from a value on
  // one line; in a label column the alignment already does that, and the colons only made a ragged right
  // edge down the column. They are new keys rather than edits to the shipped ones because the old panel
  // still binds those, and the rework measures itself on its renders not moving. The pair goes when the
  // old panel does.
  // 🔴 "Application", not "Target". The screen already said "application" in three places - the drop
  // hint, the Choose tooltip and the sentence above Start - and "Target" in exactly one, so this removes
  // an inconsistency rather than inventing a vocabulary. Target stays the word in the CLI, the docs and
  // the wire, where it names an argument rather than addressing a person seeing the tool for the first
  // time.
  "setup.label_target": "Application",
  // "At" never said at WHAT. This one says the fake clock STARTS here, which is the fact a first run
  // needs and the reason the multiplier below makes sense.
  "setup.label_at": "Starts at",
  "setup.label_zone": "Time zone",
  // Short on purpose. A shared label column is as wide as its longest entry, so "Relative to now" pushed
  // At and Zone a third of the way across the card away from their own fields. The controls beside it say
  // the rest: "From now  + 1 days [Set]".
  "setup.label_shift": "From now",
  "setup.label_mode": "Speed",
  "setup.label_args": "Arguments",
  "setup.label_cwd": "Working folder",

  // 🔴 The three options, said in words rather than in ours. The shipped panel labels them "Scale
  // duration too", "Scale QPC too" and "Run even if it does not work" - the first two are our vocabulary
  // and an acronym only a Windows developer knows, and the third never says what "it" is. Every one of
  // these sentences was already written correctly, in the tooltip nobody reads first.
  "setup.opt_duration": "Also speed up timers and countdowns inside the application",
  "setup.opt_qpc": "Also speed up timers that measure elapsed time (Stopwatch, nanoTime, monotonic)",
  "setup.opt_force": "Start even if the fake clock turns out not to work",
  "setup.opt_embedded": "Reach the web pages inside the application",

  // Fits after a number, like the shipped one. It names the button to press rather than quoting it in
  // passing, because a reader who has never opened the calculator cannot tell a quotation from a label.
  "setup.scenario_parametric": "more need a value you choose. Build one in the calculator, then press “Use this date” there.",

  // The shipped tooltip says the ready-made moments are in the list ABOVE, which stopped being true when
  // the field moved to the top of its section. Same text, one word honest again, and shorter.
  "setup.tip_shift": "Fills the date above with now, shifted by this much - the command line spells it --at +30d. Months, quarters and years land on the calendar date, not on a fixed number of hours. One shift and no more: business days are absent because a session carries no holiday calendar, and ready-made dates such as a month end are in the list below.",


  // The two options that can cost something. The tooltip carries the full story; these carry the part a
  // reader has to weigh BEFORE ticking, where the decision is made rather than a hover away from it.
  "setup.opt_qpc_note": "Can make animation and video inside the application look wrong.",
  "setup.opt_force_note": "The session is then marked unreliable everywhere it appears.",
  "setup.opt_embedded_note": "Opens a local debugging port in the application's web engine for the session. Other programs on this computer can reach it while the application runs.",

  // Both of these say "target" in the shipped panel, which is the word this screen stopped using.
  "setup.tip_recent": "The applications you have run before. Choose… picks one this machine has not run yet.",
  "setup.tip_start": "Launches the application under the fake clock. Needs an application and a valid date.",

  // Shown only while the date field still holds the one this build ships with. A pre-filled date in 2038
  // looks arbitrary to a first reader, and an unexplained value is a value nobody trusts.
  "setup.default_moment_note": "The 32-bit time boundary - a common first test. Change it, or pick a scenario below.",

  // "Set" reads as already set, which is exactly what this row is not: it holds numbers nobody has
  // applied yet. The button says what pressing it does.
  "setup.action_fill": "Fill the date",

  // Marks a recent target whose file is gone (a wiped build output, an uninstalled app). Shown rather than the entry being dropped, so the list never goes quiet about why a shortcut will not work (rule 6).
  "target.missing": "(missing)",

  // Shown only while no target is chosen: dropping a file on the window is not discoverable on its own, and once there is a target the hint would be noise on every later run (chrono-mock 7.1 pt 1).
  "target.drop_hint": "…or drag an application onto this window",
  "target.drop_rejected_title": "That file cannot be a target",
  "target.drop_rejected": "Only .exe files can be run - a shortcut or a script is not something a clock can be attached to.",

  // Arguments and working folder (chrono-mock 7.1 pt 1). Collapsed by default: most sessions need neither. The wire and the mechanism have carried both since the protocol was written; only the surfaces did not offer them.
  "launch.header": "Arguments and working folder",
  "launch.args_label": "Arguments:",
  "launch.cwd_label": "Working folder:",

  // Time inputs (chrono-mock 7.1). The moment is the local time in the session zone (rule 2).
  "moment.label": "At:",
  "moment.date_placeholder": "YYYY-MM-DD",
  "moment.time_placeholder": "HH:MM",
  // What a screen reader calls the two fields of a moment input - the placeholder is a hint, not a name.
  "moment.date_name": "Date",
  "moment.time_name": "Time",
  "moment.date_empty": "Enter a date.",
  "moment.date_format": "Use the form YYYY-MM-DD.",
  "moment.date_invalid": "That date does not exist.",
  "moment.date_year_range": "That year is outside the range this window handles (1-9999). The calculator computes on a wider band.",
  "moment.time_format": "Use HH:MM (24-hour).",
  // Reads the typed moment back in plain language (chrono-mock 7.1 pt 3). Only a lead-in: the date itself is formatted in the interface culture, so no sentence has to be assembled from fragments.
  "moment.preview_label": "The application will see",
  "moment.relative_label": "Relative to now:",
  "moment.relative_sign": "Direction",
  "moment.relative_amount": "Amount",
  "moment.relative_unit": "Unit",
  "moment.relative_bad_amount": "Enter a whole number above zero, e.g. 30.",
  "moment.relative_failed": "That shift could not be turned into a date - it may land outside the range this build computes on.",
  "action.pick_date": "Pick a date",
  "action.today": "Today",
  "action.now": "Now",
  "action.set_relative": "Set",
  "zone.label": "Zone:",

  // Market-name hints shown beside each offset in the zone dropdown, so it is not a bare number.
  "zone.host": "this machine",
  "zone.utc": "Coordinated Universal Time",
  "zone.pl_standard": "Poland (standard)",
  "zone.pl_summer": "Poland (summer)",
  "zone.us_eastern": "US Eastern",
  "zone.us_central": "US Central",
  "zone.us_mountain": "US Mountain",
  "zone.us_pacific": "US Pacific",
  "mode.label": "Mode:",
  // 🔴 THE RATE, NOT A WORD FOR IT. This said "Flowing", which named the mechanism rather than answering
  // "how fast" - and it sat in a list whose other four entries answer that question in one glyph. A
  // reader met "Flowing" with no way to tell whether it was faster or slower than ×10. The key still
  // names the MODE, because that is its identity, and the wire value "flow" is untouched.
  //
  // Written ×1 rather than 1x to match the four beside it. A list mixing both notations would be a new
  // inconsistency traded for the one being removed.
  "mode.flow": "×1",
  "mode.frozen": "Frozen",
  // The same rate as mode.flow and deliberately the same text: this one is the in-session button that
  // sets the multiplier to 1, that one is the mode list's entry for starting at real speed. Two keys
  // because they are two controls in two phases, one reading because it is one rate.
  "mode.x1": "×1",
  "mode.x10": "×10",
  "mode.x60": "×60",
  "mode.x1440": "×1440",
  "mode.scale_duration": "Scale duration too",
  "mode.scale_qpc": "Scale QPC too",
  "mode.force": "Run even if it does not work",

  // Actions.
  "action.start": "Start",
  "action.choose_target": "Choose…",
  "action.browse_folder": "Browse…",
  "action.freeze": "Freeze",
  "action.jump_to": "Jump to",
  "action.set_speed": "Set",
  "speed.invalid": "Enter a whole number, e.g. 500.",

  // In-flight jump deltas (units carried in the button Tag).
  "jump.minus_day": "-1 day",
  "jump.minus_hour": "-1 hour",
  "jump.plus_hour": "+1 hour",
  "jump.plus_day": "+1 day",

  // Session control (M-10). Meaning is carried by the label, never by colour alone.
  "control.stop": "Stop session",

  // Session status. Meaning is carried by this label, never by colour alone. No "target" or "core" here -
  // the two mechanism words this screen dropped everywhere else, said in prose about the application and
  // its clock (P6).
  "status.idle": "Not started",
  "status.connecting": "Starting the session",
  "status.running": "Running",
  "status.ended": "Session ended",
  "status.did_not_take_effect": "Did not take effect - the application vanished",
  "status.core_stopped": "Stopped - the application's clock is frozen",
  "status.stopping": "Stopping - returning the application to the real clock",
  "status.refused": "Refused - the substitution did not take effect, so the application was stopped",
  "status.stopped": "Session stopped - the application is back on the real clock",
  "status.core_unresponsive": "Chrono Mock stopped responding - the application is back on the real clock",
  "status.core_missing": "Chrono Mock could not be started - the installation may be incomplete",
  "status.target_unsupported": "That file is not a supported executable - choose a .exe application",
  "status.target_unreadable": "The application could not be read - it may have been moved or is not accessible",
  "status.no_ready": "Chrono Mock did not start correctly",
  "status.error": "Session error",

  // Core failure reasons (RELEASE-001). When a start/fatal error ends a session, its specific reason becomes the status headline, so a failed start never reads as "Session ended". Phrased as failure statements because they ARE the status line. Emitted by the core (crates/cli, crates/mech).
  "core.hook_dll_missing": "Part of Chrono Mock is missing, so the application was not launched under a fake clock (reinstall Chrono Mock).",
  "protocol.version_mismatch": "This app and the core speak different protocol versions - reinstall Chrono Mock so both come from the same build.",
  "time.bad_mode": "Unsupported time mode - the session did not start.",
  // Rejected rather than applied: past the bound the fake clock leaves the representable date range
  // mid-session and the time channels start disagreeing, and a negative rate would run the clock
  // continuously backward - which the time model has as a jump, never as a speed.
  "time.bad_multiplier": "Speed out of range - it must be between 0 (freeze) and 1,000,000. The session did not start.",
  // 🔴 "29 February in a year that is not a leap year", not "Feb 29 in a common year". The abbreviation
  // was the only one in the interface - every other date is spelled out - and "common year" is the
  // correct term for what almost nobody calls it.
  "moment.invalid": "That date and time is not valid (a daylight-saving gap, 29 February in a year that is not a leap year, or out of range) - the session did not start.",
  // 🔴 THE SAME TWO REASONS, FOR A COMMAND REJECTED MID-SESSION. The core sends one key whether a bad
  // moment arrives with the start command or with a jump, so the panel printed "the session did not
  // start" under a status line reading "Running" - a screen contradicting itself. These say what actually
  // did not happen. Which one is used is decided by the surface, not by the core (SessionViewModel.
  // InFlightKey), because only the surface knows which command the error answered.
  "moment.invalid_in_flight": "That date and time is not valid (a daylight-saving gap, 29 February in a year that is not a leap year, or out of range) - the clock did not move.",
  "time.bad_multiplier_in_flight": "Speed out of range - it must be between 0 (freeze) and 1,000,000. The rate did not change.",
  "moment.needs_calendar": "That jump counts business days, and a running session has no calendar - jump to a date instead, or work the date out in the calculator first.",
  "moment.unsupported_kind": "The core did not recognise that kind of jump target.",
  "session.control_failed": "Could not set up the link the session is steered through - the substitution did not take effect.",
  "target.launch_failed": "Could not launch the target - the substitution did not take effect.",
  // Checked in the core before either mechanism starts. Without it the failure arrives as target.launch_failed, which blames the application for a folder that is simply not there.
  "target.cwd_missing": "The working folder does not exist - the session did not start. Pick a folder that is there, or leave it empty to start where the application normally would.",
  "target.inject_failed": "Could not attach the fake clock to that application - the substitution did not take effect (an antivirus or a hardened application may have blocked it).",
  "target.attach_failed": "Could not attach to the Chromium/Electron app - the substitution did not take effect.",
  // R2-S1. The GUI normally catches this itself (HandshakeGate, from the target's PE), so this is the
  // core's own second line of defence - reachable for a target whose real bitness differs from what its
  // file header declares, such as a .NET AnyCPU executable.
  "target.bitness_mismatch": "That application's bitness does not match this core's - a fake clock cannot cross between 32-bit and 64-bit.",
  "session.already_active": "Another Chrono Mock session is already running - only one at a time.",
  "protocol.no_command": "The core received no command - the session did not start.",
  "protocol.bad_command": "The core received a malformed command - the session did not start.",
  // Mid-session, unlike the two above: the session is still running, the line was simply not
  // readable. Reported rather than dropped, so a client waiting on `ack` is not left waiting.
  "protocol.bad_command_ignored": "The core could not read a command and ignored it - the session is still running.",
  // The two ways the command stream itself fails. They end the session, unlike a single unreadable command,
  // and each names what the client sent rather than blaming the core, which is what the silence used to do.
  "protocol.line_too_long": "A command sent to the core was too long to read, so the session ended.",
  "protocol.stream_unreadable": "The core received bytes it could not read as text, so the session ended.",
  "protocol.unsupported_command": "The core received a command it does not act on here and ignored it - the session is still running.",
  "protocol.expected_start": "The core expected a start command - the session did not start.",

  // Handshake gate refusals (surfaced before the target is launched).
  "handshake.protocol_mismatch": "Protocol version mismatch - not started",
  "handshake.bitness_mismatch": "Core bitness mismatch - not started",

  // Verifier verdict (chrono-mock 7.1). The label is paired with a glyph and a colour.
  "verdict.works": "Works",
  "verdict.partial": "Partial",
  "verdict.fails": "Fails",
  "verdict.undetermined": "Undetermined",
  "verdict.unknown": "Unknown",

  // One-sentence "what this means for the test" for a non-works verdict.
  "verdict.partial.meaning": "The application read some of its time from the real clock, so the test may be unreliable.",
  "verdict.fails.meaning": "The application went on reading the real clock where it matters, so the session was refused as unreliable.",
  "verdict.undetermined.meaning": "Coverage could not be determined - treated as unproven, never as working.",

  // Verdict reason keys the core sends over the wire (VerdictEvent / SessionVerdict reason_key), shown under a non-works verdict. The family variants (session.family_*) mirror the per-process ones and are emitted for the family aggregate at end. Wording mirrors the CLI report (describe_reason). RELEASE-002.
  "coverage.time_channels_covered": "Every process that read the time saw the fake clock.",
  "coverage.time_channels_partial": "Some time readings came from the fake clock and some from the real one.",
  "coverage.time_channels_uncovered": "The application asked for the time and always got the real clock.",
  "coverage.undetermined": "Nothing read the fake clock, so there is nothing to judge.",
  "session.family_covered": "Every process that read the time saw the fake clock.",
  "session.family_partial": "Some time readings came from the fake clock and some from the real one.",
  "session.family_uncovered": "The application asked for the time and always got the real clock.",
  "session.family_undetermined": "Nothing read the fake clock, so there is nothing to judge.",
  // Reasons when the family spawned processes the hook never got into (SLOWNIK uncoveredChild):
  // the verdict is partial or fails BECAUSE a process ran on the real clock, and the reason says so
  // in those words rather than in terms of channels.
  "session.family_partial_children": "The fake clock reached the processes listed as covered. The ones this application started without it ran on the real clock.",
  "session.family_uncovered_children": "Nothing read the fake clock, and the processes this application started without it ran on the real clock.",

  // Coverage / audit preview (chrono-mock 7.2). Channel names are raw API identifiers, not translated.
  //
  // 🔴 WHICH CLOCK THE APPLICATION READ, in those words. These four headers were written in the
  // mechanism's vocabulary - "covered", "channel", "hooked" - and the last two carried it in a
  // parenthesis, which is where jargon goes when nobody can think of the plain word. A reader of this
  // audit has one question, and untouchable rule 4 makes answering it honestly the product's promise:
  // did the application see the fake clock or the real one. The rows underneath are the API names, so
  // the header does not have to name the unit as well.
  "coverage.covered": "Read from the fake clock",
  "coverage.uncovered": "Read from the real clock",
  // Read from the real clock too, and the difference is INTENT - QPC-based timing is left alone on
  // purpose (ADR-2), and the reader has to be able to tell "we chose this" from "we missed it".
  "coverage.observed": "Left on the real clock on purpose",
  // Not the same thing as either, and the wording has to keep them apart: the two above are time the
  // application asked for, this one is a watch we promised and never started.
  "coverage.unobserved": "Could not be watched",
  // Every row here is also in one of the lists above with its count. This names which of those counts are
  // floors - which the late-hook warning needs, and could not say on its own.
  "coverage.installed_late": "Came under the fake clock late",
  "coverage.warnings": "Warnings",
  // The audit table: one row per function the session saw, with where it read its time from. The status
  // words are short because they sit in a column, and each is also the row's colour - a word first, so the
  // colour never carries the meaning alone.
  "audit.col_function": "Function",
  "audit.col_source": "Read from",
  "audit.col_reads": "Reads",
  "audit.status_fake": "fake clock",
  "audit.status_real": "real clock",
  "audit.status_by_design": "real clock, by design",
  "audit.status_by_design_late": "real clock, by design, hooked late",
  "audit.status_unwatched": "not watched",
  "audit.status_late": "fake clock, late",
  // The process table under it: the processes the family spawned and the hook never got into, one row
  // per executable and role. The heading carries the true total and the chip in the section head repeats
  // it, because the wire names at most a fixed number of them and a folded head that said nothing would
  // hide them. The "more" sentence is split around its number, like the vanish lifetime.
  "session.chip_processes": "processes on the real clock:",
  "audit.processes_heading": "Processes that ran on the real clock",
  "audit.col_process": "Process",
  "audit.col_role": "Role",
  "audit.col_count": "Count",
  "audit.process_unnamed": "exited before it could be named",
  "audit.processes_more_before": "and",
  "audit.processes_more_after": "more this report could not name",
  // The engine table. "Engine" is what the engine calls itself, read from its own version endpoint, and
  // "Port" is the loopback port it listens on - the fact the warning about an open debugging port is
  // about, and the one a reader can act on. The note says what the table means, because a list of names
  // and numbers with no sentence beside it is a list the reader has to guess the purpose of.
  "audit.engines_heading": "Web engines reached inside the application",
  "audit.col_engine": "Engine",
  "audit.col_port": "Port",
  "audit.engine_unnamed": "engine",
  "audit.engines_note": "Their pages ran on the session clock. The port is where your own DevTools would attach to those pages.",
  // The read count on a covered or observed channel, in prose so it does not read like the speed multiplier
  // the raw count sat beside - built in code (SessionViewModel.FormatChannel), P6.
  "coverage.reads": "{0} - read {1} times",
  "coverage.reads_one": "{0} - read once",
  "coverage.family_note": "Several processes ran - the call counts are the first one's, while the warnings and everything read from the real clock cover all of them.",
  "coverage.contexts_note": "A Chromium application - every JS context is listed on its own (the page and its workers), never added together.",

  // Coverage warning keys the core raises (CoverageEvent warning_keys), and the vanish reason (VanishedEvent reason_key, shown inside report.vanish_detail). Wording mirrors the CLI report (describe_warning). The Chromium (CDP) warnings live in the section below. RELEASE-002.
  "source.network_at_start": "The application opened a network connection - it may read the time from a server, which no local clock can change.",
  "wait.object_waits_not_scaled": "Waits on system objects are left on the real clock on purpose - an I/O or hardware timeout is not shortened.",
  "wait.timeout_collapsed": "Some of this application's waits were too short to divide by the full speed factor, so they ran at the shortest step this tool uses (1 ms) instead. That part of the application did not accelerate - a lower speed makes it exact again.",
  "timer.multimedia_not_scaled": "The multimedia timer (timeSetEvent) is observed but not scaled.",
  "clock.timegettime_scaled_audio_may_shift": "The winmm clock timeGetTime is being scaled with the rest of the duration axis, so a target that paces itself from it follows the session - but a media application that positions audio from that clock may drift.",
  "coverage.channel_installed_late": "The functions listed as coming under the fake clock late were hooked only once their own module loaded, so calls the application made before that are missing from their counts - and a scaled one's clock jumped once when it joined.",
  "inheritance.ntcreateuserprocess_child_maybe_uncovered": "A child process started through a lower-level call may have run on the real clock.",
  // R2-S2. Distinct from the NtCreateUserProcess warning above it: there we choose not to inject,
  // here we tried and it did not take, so a process of this family really did run on the real clock.
  "inheritance.child_not_injected": "A child process could not be given the fake clock and ran on the real one - usually a child of a different bitness. The process count is short by that many.",
  // Session-level, on session_verdict: the family spawned processes the hook never got into, named
  // in uncovered_children. The strong claim needs a renderer among them (known by the role on its
  // command line) - that is the process the pages run in. An engine image without a renderer named
  // gets the weak claim, because the GPU and utility processes carry the same image name.
  "inheritance.children_uncovered": "This application started processes that never got the fake clock - they ran on the real one the whole time.",
  "embedded.web_engine_uncovered": "One of them is a web engine's renderer - the process web pages run in. The pages hosted by that renderer read the real clock: a renderer running in a sandbox is out of reach for the native mechanism.",
  "embedded.web_engine_processes_uncovered": "They include processes of an embedded web engine (WebView2 or Qt WebEngine), so part of that engine ran on the real clock. Whether its pages did could not be established: no renderer was among the processes named.",
  // The embedded-engine channel (docs/09 section 12): the pages inside the application, reached
  // through its own web engine's debugging port and put on the session clock from there.
  "embedded.web_engine_reached": "One of them is a web engine's renderer - the process web pages run in. Those pages were reached through the engine's debugging port and ran on the session clock (the page rows in the table). The renderer's own native reads and the engine's helper processes ran on the real clock.",
  "embedded.debug_port_open": "A local debugging port was opened in this application's web engine for the session - that is how its pages were put on the session clock. It stays open to other programs on this computer for as long as the engine runs.",
  "embedded.engine_unreachable": "A web engine inside this application opened a debugging port, but the session could not attach to it. Its pages ran on the real clock.",
  "embedded.discovery_unavailable": "The session could not look for web engines inside this application, so any pages inside it ran on the real clock.",
  "embedded.qt_port_taken": "The port reserved for the application's Qt web engine was taken by something else before the engine could use it. Its pages could not be reached and ran on the real clock.",
  "embedded.zone_is_host": "The pages inside this application read this computer's time zone, not the session's. A local time they show differs from the rest of the application by the zone offset.",
  "embedded.registry_arguments_hidden": "This application has WebView2 browser arguments set in the registry. The session hid them for its duration, so whatever they set up (a debugging port of your own, say) was not applied.",
  // R2-S9. Session-level, not per-process: it is about processes that never got a coverage slot,
  // so it arrives on session_verdict rather than on any one coverage event.
  "coverage.pid_registry_full": "This session ran more processes than the audit can track (256). Some ran with no fake clock at all and are missing from the process count and the lists above.",
  "time.fake_clock_clamped": "The fake clock reached the last date this build can represent (year 30828) and stood there for the rest of the session. Late readings are not the moments the chosen speed would have produced.",
  "time.duration_axis_clamped": "The monotonic counters (tick count, unbiased interrupt time, and QPC when scaled) reached the end of their range and stood there, so elapsed time inside the application stopped advancing even though the session went on. A lower speed or a shorter session avoids it.",
  "target.single_instance_suspected": "exited right after it started, before the substitution could be confirmed",

  // Runtime detected statically from the target's files (B1): its monotonic/elapsed clocks stand on QueryPerformanceCounter, which stays real (ADR-2), so a timer built on them does not scale even though the wall clock does. Wording mirrors the CLI describe_warning.
  "runtime.python_monotonic_qpc": "This Python app measures time with perf_counter and monotonic - both use QueryPerformanceCounter on Python 3.13+, which is left real, so a timer built on them does not scale (time.time and the wall clock do).",
  "runtime.python_perfcounter_qpc": "This Python app's perf_counter uses QueryPerformanceCounter, which is left real, so a perf_counter timer does not scale - on Python 3.13+ monotonic uses QPC too (time.time and the wall clock do scale).",
  "runtime.dotnet_stopwatch_qpc": "This .NET app's Stopwatch uses QueryPerformanceCounter, which is left real, so a Stopwatch timer does not scale (DateTime and Environment.TickCount do).",
  "runtime.java_nanotime_qpc": "This Java app's System.nanoTime uses QueryPerformanceCounter, which is left real, so a nanoTime timer does not scale (System.currentTimeMillis does).",
  "runtime.unity_delta_time_capped": "A Unity game: the engine caps how far it advances the simulation in a single frame (Time.maximumDeltaTime), so the gameplay hits a ceiling of its own and stops following the session speed well below it. The wall clock, dates and timestamps still move at the session rate, and no amount of clock coverage raises that ceiling.",

  // Shown when QPC scaling is ON (the scale-qpc option, ADR-2 reversal): the monotonic/elapsed clock now scales, but a target that times rendering off QPC may look distorted. Replaces the runtime QPC warnings.
  "qpc.scaled_render_may_distort": "QueryPerformanceCounter is being scaled, so a QPC-timed monotonic/elapsed clock accelerates - but a target that times its rendering or animation off QPC may look distorted.",

  // Chromium/Electron (CDP) mode, ADR-8/ADR-9: verdict reasons and warnings the CDP core emits. The coverage unit is a JS context, not an OS process.
  "chromium.contexts_covered": "Every JS context ran on the fake clock.",
  "chromium.contexts_partial": "Some JS contexts ran on the fake clock and some could not be reached.",
