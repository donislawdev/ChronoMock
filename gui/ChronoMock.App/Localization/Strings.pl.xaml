  <sys:String x:Key="coverage.contexts_note">Sesja Chromium - pokazano każdy kontekst JS (stronę i workery), nigdy sumowane.</sys:String>

  <!-- Klucze ostrzeżeń pokrycia emitowane przez rdzeń (CoverageEvent warning_keys) oraz powód zniknięcia
