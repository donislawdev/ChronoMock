  <sys:String x:Key="coverage.time_channels_covered">Każdy proces, który odczytał czas, widział zegar sesji.</sys:String>
  <sys:String x:Key="coverage.time_channels_partial">Część kanałów czasu objęto, część odpytano ale nie objęto.</sys:String>
