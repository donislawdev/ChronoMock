<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Polish interface strings. Same key set as Strings.en.xaml (a test enforces parity); values translated. -->
  <sys:String x:Key="app.title">Chrono Mock</sys:String>

  <!-- Clock roles. -->
  <sys:String x:Key="clock.fake">Zegar fałszywy</sys:String>
  <sys:String x:Key="clock.real">Zegar rzeczywisty</sys:String>

  <!-- Wybór celu (chrono-mock 7.1). Teksty dialogu też jako klucze (reguła 15). -->
  <sys:String x:Key="target.label">Cel:</sys:String>
  <sys:String x:Key="target.dialog_title">Wybierz cel</sys:String>
  <sys:String x:Key="target.dialog_filter">Pliki wykonywalne (*.exe)|*.exe|Wszystkie pliki (*.*)|*.*</sys:String>

  <!-- Wejścia czasu (chrono-mock 7.1). Moment to czas lokalny w strefie sesji (reguła 2). -->
  <sys:String x:Key="moment.label">Moment:</sys:String>
  <sys:String x:Key="moment.invalid">Wpisz moment w formie 2038-01-19T03:14:07 (data i godzina).</sys:String>
  <sys:String x:Key="zone.label">Strefa:</sys:String>
  <sys:String x:Key="mode.label">Tryb:</sys:String>
  <sys:String x:Key="mode.flow">Płynący</sys:String>
  <sys:String x:Key="mode.frozen">Zamrożony</sys:String>
  <sys:String x:Key="mode.x1">×1</sys:String>
  <sys:String x:Key="mode.x10">×10</sys:String>
  <sys:String x:Key="mode.x60">×60</sys:String>
  <sys:String x:Key="mode.x1440">×1440</sys:String>
  <sys:String x:Key="mode.scale_duration">Skaluj też czas trwania</sys:String>

  <!-- Actions. -->
  <sys:String x:Key="action.start">Start</sys:String>
  <sys:String x:Key="action.choose_target">Wybierz…</sys:String>
  <sys:String x:Key="action.freeze">Zamroź</sys:String>

  <!-- Skoki w locie (jednostki w Tag przycisku). -->
  <sys:String x:Key="jump.minus_day">-1 dzień</sys:String>
  <sys:String x:Key="jump.minus_hour">-1 godz.</sys:String>
  <sys:String x:Key="jump.plus_hour">+1 godz.</sys:String>
  <sys:String x:Key="jump.plus_day">+1 dzień</sys:String>

  <!-- Session status. -->
  <sys:String x:Key="status.idle">Nie uruchomiono</sys:String>
  <sys:String x:Key="status.connecting">Uruchamianie rdzenia</sys:String>
  <sys:String x:Key="status.running">Działa</sys:String>
  <sys:String x:Key="status.ended">Sesja zakończona</sys:String>
  <sys:String x:Key="status.did_not_take_effect">Nie zadziałało - cel zniknął</sys:String>
  <sys:String x:Key="status.core_stopped">Rdzeń zatrzymany - czas celu zamrożony</sys:String>
  <sys:String x:Key="status.core_missing">Nie można uruchomić sesji demo - najpierw zbuduj rozwiązanie</sys:String>
  <sys:String x:Key="status.no_ready">Brak uzgodnienia z rdzeniem</sys:String>
  <sys:String x:Key="status.error">Błąd sesji</sys:String>

  <!-- Odmowy bramki uzgodnienia (zgłaszane, zanim cel zostanie uruchomiony). -->
  <sys:String x:Key="handshake.protocol_mismatch">Niezgodna wersja protokołu - nie uruchomiono</sys:String>
  <sys:String x:Key="handshake.bitness_mismatch">Niezgodna bitowość rdzenia - nie uruchomiono</sys:String>

  <!-- Werdykt weryfikatora (chrono-mock 7.1). Etykieta w parze z glifem i kolorem. -->
  <sys:String x:Key="verdict.works">Działa</sys:String>
  <sys:String x:Key="verdict.partial">Częściowo</sys:String>
  <sys:String x:Key="verdict.fails">Nie działa</sys:String>
  <sys:String x:Key="verdict.undetermined">Nieokreślony</sys:String>
  <sys:String x:Key="verdict.unknown">Nieznany</sys:String>

  <!-- Jedno zdanie „co to znaczy dla testu" dla werdyktu innego niż działa. -->
  <sys:String x:Key="verdict.partial.meaning">Część kanałów czasu nie została objęta - ich odczyty są prawdziwe, więc test może być niewiarygodny.</sys:String>
  <sys:String x:Key="verdict.fails.meaning">Podmiana nie objęła kluczowych kanałów - sesja odrzucona jako niewiarygodna.</sys:String>
  <sys:String x:Key="verdict.undetermined.meaning">Nie dało się ustalić pokrycia - traktowane jako niepotwierdzone, nigdy jako działające.</sys:String>

  <!-- Pokrycie / podgląd audytu (chrono-mock 7.2). Nazwy kanałów to surowe identyfikatory API, nietłumaczone. -->
  <sys:String x:Key="coverage.covered">Objęte kanały</sys:String>
  <sys:String x:Key="coverage.observed">Obserwowane (podpięte, pozostawione realne)</sys:String>
  <sys:String x:Key="coverage.uncovered">Nieobjęte kanały</sys:String>
  <sys:String x:Key="coverage.warnings">Ostrzeżenia</sys:String>
  <sys:String x:Key="coverage.family_note">Sesja rodziny - pokazano pokrycie procesu rodzica.</sys:String>

  <!-- Kopiowanie podsumowania sesji (chrono-mock 7.2, 8.8). Raport do wklejenia w zgłoszenie; sesja inna
       niż „działa" prowadzi banerem nierzetelności. Klucze z szablonem niosą pola {0}. -->
  <sys:String x:Key="action.copy_summary">Kopiuj podsumowanie</sys:String>
  <sys:String x:Key="copy.done">Skopiowano do schowka</sys:String>
  <sys:String x:Key="copy.failed">Nie można skopiować - schowek jest zajęty</sys:String>
  <sys:String x:Key="report.unreliable_banner">!! DOWÓD NIERZETELNY - podmiana czasu nie zadziałała w pełni. Nie cytuj tego jako dowodu zachowania.</sys:String>
  <sys:String x:Key="report.title">Chrono Mock - raport sesji</sys:String>
  <sys:String x:Key="report.target">cel</sys:String>
  <sys:String x:Key="report.verdict">werdykt</sys:String>
  <sys:String x:Key="report.no_verdict">brak werdyktu</sys:String>
  <sys:String x:Key="report.did_not_take_effect">NIE ZADZIAŁAŁO - cel zniknął zaraz po wstrzyknięciu</sys:String>
  <sys:String x:Key="report.vanish_detail">podejrzenie aplikacji jednoinstancyjnej: {0} - działał {1} ms</sys:String>
  <sys:String x:Key="report.processes">procesy: {0}</sys:String>
  <sys:String x:Key="report.session">sesja</sys:String>
  <sys:String x:Key="report.session_reached">fałszywy zegar osiągnął {0}</sys:String>
  <sys:String x:Key="report.elapsed">realnie {0}s, fałszywie {1}s</sys:String>
  <sys:String x:Key="report.requested">żądano: {0} (strefa {1}, tryb {2})</sys:String>

  <!-- Historia sesji (chrono-mock 7.2, 8.8, 11.1 pkt 13). Tylko lokalnie; klik wpisu wypełnia formularz
       setup i nigdy nie uruchamia sesji (reguła nietykalna 7, docs/04 §6). -->
  <sys:String x:Key="history.header">Historia</sys:String>
  <sys:String x:Key="history.save_failed">Nie udało się zapisać do historii:</sys:String>
  <sys:String x:Key="history.delete">Usuń tę sesję</sys:String>
  <sys:String x:Key="history.clear">Wyczyść</sys:String>
  <sys:String x:Key="history.clear_title">Wyczyść historię</sys:String>
  <sys:String x:Key="history.clear_confirm">Wyczyścić wszystkie zapisane sesje? Tej operacji nie można cofnąć.</sys:String>

  <!-- Przełącznik modułów: dwie połowy produktu (chrono-mock 6.1/7). -->
  <sys:String x:Key="nav.substitution">Podmiana</sys:String>
  <sys:String x:Key="nav.calculator">Kalkulator</sys:String>

  <!-- Kalkulator dat (chrono-mock 7.3). Plasterek G1 to szkielet układu; więcej kluczy z podpięciem. -->
  <sys:String x:Key="calc.presets_header">Presety</sys:String>
  <sys:String x:Key="calc.filter_placeholder">Filtruj scenariusze…</sys:String>
  <sys:String x:Key="calc.build_from_scratch">+ Zbuduj od zera</sys:String>
  <sys:String x:Key="calc.preset_note">Preset to punkt startowy - nie certyfikat kompletności testu.</sys:String>
  <sys:String x:Key="calc.build_header">Zbuduj moment</sys:String>
  <sys:String x:Key="calc.start_point">Punkt startowy</sys:String>
  <sys:String x:Key="calc.steps_header">Kroki</sys:String>
  <sys:String x:Key="calc.add_step">+ Dodaj krok</sys:String>
  <sys:String x:Key="calc.kind_shift">Przesuń ±</sys:String>
  <sys:String x:Key="calc.kind_snap">Przeskocz do</sys:String>
  <sys:String x:Key="calc.kind_nearest">Najbliższy</sys:String>
  <sys:String x:Key="calc.kind_settime">Ustaw godzinę</sys:String>
  <sys:String x:Key="calc.kind_zone">Zmień strefę</sys:String>
  <sys:String x:Key="calc.result_header">Wynik</sys:String>
  <sys:String x:Key="calc.what_tests">Co ta data testuje</sys:String>
  <sys:String x:Key="calc.all_formats">Wszystkie formaty - kopiuj jednym klikiem</sys:String>
  <sys:String x:Key="calc.copy">Kopiuj</sys:String>
  <sys:String x:Key="calc.metadata">Metadane</sys:String>
  <sys:String x:Key="calc.other_zones">Ta sama chwila, inne strefy</sys:String>
  <sys:String x:Key="calc.use_in_substitution">Użyj w podmianie →</sys:String>
  <sys:String x:Key="calc.reverse_header">Analiza wklejonej daty</sys:String>
  <sys:String x:Key="calc.preview_note">Presety i analiza odwrotna to wciąż podgląd - konstruktor i wynik są na żywo.</sys:String>

  <!-- Konstruktor kalkulatora (G3b): rodzaje bazy, jednostki shift, kalendarze i markery znaczenia. -->
  <sys:String x:Key="calc.base.today">Dziś</sys:String>
  <sys:String x:Key="calc.base.now">Teraz</sys:String>
  <sys:String x:Key="calc.base.specific">Konkretna data</sys:String>
  <sys:String x:Key="calc.field_calendar">Kalendarz:</sys:String>
  <sys:String x:Key="calc.remove_step">Usuń krok</sys:String>

  <sys:String x:Key="calc.unit.seconds">sekundy</sys:String>
  <sys:String x:Key="calc.unit.minutes">minuty</sys:String>
  <sys:String x:Key="calc.unit.hours">godziny</sys:String>
  <sys:String x:Key="calc.unit.days">dni</sys:String>
  <sys:String x:Key="calc.unit.weeks">tygodnie</sys:String>
  <sys:String x:Key="calc.unit.months">miesiące</sys:String>
  <sys:String x:Key="calc.unit.quarters">kwartały</sys:String>
  <sys:String x:Key="calc.unit.years">lata</sys:String>
  <sys:String x:Key="calc.unit.business_days">dni robocze</sys:String>

  <sys:String x:Key="calc.cal.none">(brak)</sys:String>
  <sys:String x:Key="calc.cal.us_banking">USA bankowy</sys:String>
  <sys:String x:Key="calc.cal.us_federal">USA federalny</sys:String>
  <sys:String x:Key="calc.cal.pl">Polska</sys:String>

  <!-- Cele kroku snap (G3c-1): granica okresu, do której skacze krok. Tokeny lustrzą flagę snap. -->
  <sys:String x:Key="calc.snap.som">Początek miesiąca</sys:String>
  <sys:String x:Key="calc.snap.eom">Koniec miesiąca</sys:String>
  <sys:String x:Key="calc.snap.soq">Początek kwartału</sys:String>
  <sys:String x:Key="calc.snap.eoq">Koniec kwartału</sys:String>
  <sys:String x:Key="calc.snap.soy">Początek roku</sys:String>
  <sys:String x:Key="calc.snap.eoy">Koniec roku</sys:String>

  <sys:String x:Key="calc.sig.start_of_month">Pierwszy dzień miesiąca</sys:String>
  <sys:String x:Key="calc.sig.end_of_month">Ostatni dzień miesiąca (koniec miesiąca)</sys:String>
  <sys:String x:Key="calc.sig.start_of_quarter">Pierwszy dzień kwartału</sys:String>
  <sys:String x:Key="calc.sig.end_of_quarter">Ostatni dzień kwartału (koniec kwartału)</sys:String>
  <sys:String x:Key="calc.sig.start_of_year">Pierwszy dzień roku</sys:String>
  <sys:String x:Key="calc.sig.end_of_year">Ostatni dzień roku (przełom roku)</sys:String>
  <sys:String x:Key="calc.sig.leap_day">29 lutego - dzień przestępny</sys:String>
  <sys:String x:Key="calc.sig.last_day_of_february_common_year">28 lutego - ostatni dzień lutego (rok zwykły, bez 29 lutego)</sys:String>
  <sys:String x:Key="calc.sig.unix_epoch">Epoka Unix (1970-01-01T00:00:00Z, epoch 0)</sys:String>
  <sys:String x:Key="calc.sig.year_2038_boundary">Na granicy 32-bitowego time_t 2038-01-19 lub za nią (Y2038)</sys:String>
  <sys:String x:Key="calc.sig.weekend">Weekend - nie jest dniem roboczym</sys:String>
  <sys:String x:Key="calc.sig.public_holiday">Święto</sys:String>
  <sys:String x:Key="calc.sig.observed_holiday">Obchodzone święto - dzień wolny przesunięty z weekendowego święta</sys:String>

</ResourceDictionary>
