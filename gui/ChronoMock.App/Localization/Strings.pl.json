  "coverage.covered": "Objęte kanały",
  "coverage.observed": "Obserwowane (podpięte, pozostawione realne)",
  "coverage.uncovered": "Nieobjęte kanały",
  // Not the same thing as uncovered, and the wording has to keep them apart: an uncovered channel is
