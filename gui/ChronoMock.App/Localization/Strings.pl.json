// Polish interface strings. Keys are stable and English, values are the display text.
// This file is Strings.en.json with the values translated, and a new language is made the
// same way: copy that file, name it Strings.<culture>.json, translate the values, no
// recompile (untouchable rule 15). JSON with // comments: this file is DATA, read as data.
// It used to be XAML parsed by XamlReader, which instantiates types and therefore ran as
// code - a loose file next to the exe must never be able to do that.
{

  // The window title and the title bar. {0} is the product version, filled in at startup from the
  // running build - the number is never written here, so there is nothing extra to bump. A
  // translation that drops {0} gets a title without a version rather than an error.
  "app.title": "Chrono Mock {0}",

  // Clock roles.
  "clock.fake": "Zegar fałszywy",
  "clock.real": "Zegar rzeczywisty",
  // 🔴 How much time PASSED on that clock, which is the multiplier as a fact rather than a number to
  // trust. A label, because a bare duration beside a wall reading is two numbers and no way to tell
  // them apart.
  "clock.elapsed": "upłynęło",

  // Target selection (chrono-mock 7.1). The dialog strings are keyed too (rule 15).
  "target.dialog_title": "Wybierz aplikację",

  // Only .exe: native injection needs a PE and CDP needs an Electron/Chromium .exe. Narrowing the filter keeps a user from picking a .lnk/.bat/.txt that could only fail (RELEASE-007).
  "target.dialog_filter": "Programy i skróty (*.exe, *.lnk)|*.exe;*.lnk",

  // Scenarios (chrono-mock 7.1 pt 2): named moments from the shared preset catalogue. The scenario NAMES and their "what this date tests" lines come from the catalogue files (data locales), not from here.
  "scenario.failed": "Nie udało się policzyć daty dla tego scenariusza.",
  "scenario.unsupported": "Plik presetu tego scenariusza ma kształt, którego ta wersja nie czyta.",
  "scenario.engine_missing": "Nie udało się uruchomić silnika kalkulatora, więc scenariuszy nie da się policzyć.",

  // The list is searched rather than scanned, because the catalogue is meant to grow. Nothing matched and
  // nothing installed are opposite problems, so they get different sentences - and the first one says what
  // to do about it, never only that something is wrong.
  "scenario.filter_placeholder": "Szukaj scenariuszy",
  "scenario.no_matches": "Żaden scenariusz nie pasuje. Wyczyść pole, żeby zobaczyć wszystkie.",
  "scenario.clear_filter": "Wyczyść wyszukiwanie",
  "scenario.list_reading": "Wczytywanie scenariuszy…",
  "scenario.list_failed": "Nie udało się wczytać listy scenariuszy.",
  "scenario.list_empty": "Nie ma scenariuszy do wyboru.",
  "scenario.left_out_before": "Pominięte pliki presetów:",
  "scenario.left_out_after": "- powód podaje polecenie chrono presets.",
  "presets.err.folder_missing": "Brakuje folderu presetów - instalacja może być niekompletna. Rozpakuj paczkę ponownie.",
  "presets.err.folder_unreadable": "Nie udało się odczytać folderu presetów - sprawdź, czy Windows pozwala temu kontu go otworzyć.",
  "calendars.err.folder_missing": "Brakuje folderu kalendarzy - instalacja może być niekompletna. Rozpakuj paczkę ponownie.",
  "calendars.err.folder_unreadable": "Nie udało się odczytać folderu kalendarzy - sprawdź, czy Windows pozwala temu kontu go otworzyć.",

  // The rebuilt setup screen: one thing always visible and the rest folded away behind a header that keeps
  // saying what is set inside it. The chips are deliberately short - they sit in a section header beside a
  // speed, where a full sentence would push the speed off the end.
  // 🔴 One line saying what the screen does and what it will not do, because somebody opening this for
  // the first time has no way of knowing either. The second half is the product's whole promise
  // (untouchable rule 1) and the question a stranger actually has: is this going to change my computer.
  "setup.intro": "Uruchamia aplikację tak, jakby była inna data i godzina. Zegar systemowy pozostaje nietknięty.",

  // "Moment" is our word, not the reader's.
  "setup.section_moment": "Data i godzina",
  "setup.section_speed": "Tempo i opcje",
  // 🔴 The catalogue is its own group now, and folded. Measured at the window's real height: the moment
  // section was 603 px of a 671 px viewport because the catalogue lived inside it, so the two groups
  // under it were not merely below the fold - they were invisible on a first run, which is the fault this
  // rework exists to remove, in a new shape.
  "setup.section_scenario": "Scenariusze",
  // A label and a value, so the count is grammatical whatever it is. "16 ready-made dates" reads well
  // and "1 ready-made dates" does not, and a summary is not the place to start pluralising in two
  // languages.
  "setup.scenario_available": "gotowych dat:",
  "setup.needs_target": "Wybierz aplikację, zanim wystartujesz.",
  // 🔴 The other two refusals, which the footer had no words for. It said why Start was disabled only
  // when no application had been chosen - so a picked application plus an unreadable date left a dead
  // button with no account of itself, and at the window's floor the field's own message is off-screen.
  // These point at the field rather than repeating its message: the field says WHAT is wrong, this says
  // where to go and that it is what is holding Start.
  "setup.needs_moment": "Popraw datę i godzinę powyżej, zanim wystartujesz.",
  "setup.scenario_failed": "Wybrany scenariusz nie dał daty - wybierz inny albo wpisz datę powyżej, zanim wystartujesz.",
  "setup.moment_pending": "Data wciąż się liczy - naciśnij Start ponownie, gdy pojawi się powyżej.",
  // 🔴 The session phase's own keys, in its own namespace, for the same reason the setup phase has its:
  // every key shared with the shipped panel moves that panel's pixels, and these go with the old screen
  // when the product adopts the parts library.
  // 🔴 The question, not our word for asking it. "Audit" is the mechanism's name for this block and
  // the reader has one question it answers - the same reason the four headers inside it stopped
  // saying "covered channel".
  "session.section_audit": "Co aplikacja odczytała",
  "session.label_jump": "Skok",
  "session.jump_note": "Zegar trwania nigdy nie cofa się, także przy skoku wstecz.",
  "session.label_jump_to": "Skok do",
  "session.action_jump_to": "Skocz",
  "session.rate_placeholder": "dowolne tempo",
  // 🔴 Application, not Running. The line outlives the run - the same screen shows a session that has
  // ended - and "Running:" stood above "Session ended" there.
  "session.application_label": "Aplikacja:",
  "session.stop_note": "Zatrzymanie przywraca aplikacji prawdziwy zegar. Nie zamyka jej.",
  // Without "audit" and "core", the two mechanism words this screen stopped using everywhere else.
  "session.audit_pending": "Zegary, które odczytuje ta aplikacja, pojawią się tutaj, gdy narzędzie to sprawdzi.",
  // When the session is over and no report came, the sentence above would be a promise nobody keeps.
  "session.audit_never_arrived": "Sesja skończyła się, zanim narzędzie zdążyło sprawdzić, które zegary odczytuje ta aplikacja.",
  // And when there was no session at all - a start that failed before the first heartbeat. The sentence
  // above says "the session ended", which is false of a session that never began.
  "session.audit_never_started": "Aplikacja nigdy nie wystartowała pod fałszywym zegarem, więc nie było czego sprawdzać.",
  // A label and a number, for the reason setup.scenario_available gives: "1 warnings" was on this header.
  "session.chip_covered": "fałszywy zegar:",
  "session.chip_uncovered": "prawdziwy zegar:",
  "session.chip_unobserved": "nie dało się obserwować:",
  "session.chip_warnings": "ostrzeżenia:",
  "setup.already_running": "Sesja już działa.",
  "setup.chip_duration": "trwanie skalowane",
  "setup.chip_qpc": "QPC skalowane",
  "setup.chip_force": "start wymuszony",
  "setup.chip_no_embedded": "bez stron WWW",
  "setup.chip_elevated_embedded": "dotarcie do stron administratora",
  "setup.chip_keep_timers": "ukryte okna w tempie",
  // The launch fields moved into this section, so its folded header says they are set without printing
  // values that have no length limit.
  "setup.chip_args": "argumenty ustawione",
  "setup.chip_cwd": "folder ustawiony",
  // The contract sentence above Start names the CLOCK - the instant and the rate. The options are how the
  // rate is delivered rather than what the application sees, so they stay in the section header and the
  // sentence does not repeat them.
  // 🔴 A label, not a preposition. "running at ×60" reads well and "running at Flowing" does not, and the
  // mode list holds both kinds of value - a rate and a manner. A label and a value is grammatical
  // whatever the list is asked to hold next.
  "setup.contract_speed": "tempo:",

  // 🔴 The form labels again, without their trailing colons. A colon separates a label from a value on
  // one line; in a label column the alignment already does that, and the colons only made a ragged right
  // edge down the column. They are new keys rather than edits to the shipped ones because the old panel
  // still binds those, and the rework measures itself on its renders not moving. The pair goes when the
  // old panel does.
  // 🔴 "Application", not "Target". The screen already said "application" in three places - the drop
  // hint, the Choose tooltip and the sentence above Start - and "Target" in exactly one, so this removes
  // an inconsistency rather than inventing a vocabulary. Target stays the word in the CLI, the docs and
  // the wire, where it names an argument rather than addressing a person seeing the tool for the first
  // time.
  "setup.label_target": "Aplikacja",
  // "At" never said at WHAT. This one says the fake clock STARTS here, which is the fact a first run
  // needs and the reason the multiplier below makes sense.
  "setup.label_at": "Start od",
  "setup.label_zone": "Strefa czasowa",
  // Short on purpose. A shared label column is as wide as its longest entry, so "Relative to now" pushed
  // At and Zone a third of the way across the card away from their own fields. The controls beside it say
  // the rest: "From now  + 1 days [Set]".
  "setup.label_shift": "Od teraz",
  "setup.label_mode": "Tempo",
  "setup.label_args": "Argumenty",
  "setup.label_cwd": "Katalog roboczy",
  "setup.from_shortcut": "Wypełnione ze skrótu, razem z jego argumentami i katalogiem roboczym - oba są w sekcji Tempo i opcje.",

  // 🔴 The three options, said in words rather than in ours. The shipped panel labels them "Scale
  // duration too", "Scale QPC too" and "Run even if it does not work" - the first two are our vocabulary
  // and an acronym only a Windows developer knows, and the third never says what "it" is. Every one of
  // these sentences was already written correctly, in the tooltip nobody reads first.
  "setup.opt_duration": "Przyspiesz też liczniki i odliczanie wewnątrz aplikacji",
  "setup.opt_qpc": "Przyspiesz też liczniki mierzące upływ czasu (Stopwatch, nanoTime, monotonic)",
  "setup.opt_force": "Uruchom nawet wtedy, gdy okaże się, że fałszywy zegar nie działa",
  "setup.opt_embedded": "Sięgnij do stron WWW wewnątrz aplikacji",
  "setup.opt_elevated_embedded": "Dotrzyj do stron w aplikacji uruchomionej jako administrator",
  "setup.opt_keep_timers": "Utrzymuj tempo timerów w ukrytych oknach",

  // Fits after a number, like the shipped one. It names the button to press rather than quoting it in
  // passing, because a reader who has never opened the calculator cannot tell a quotation from a label.
  "setup.scenario_parametric": "kolejnych wymaga wartości, którą wybierasz. Zbuduj taki w kalkulatorze, potem naciśnij tam „Użyj tej daty”.",
  "setup.scenario_unavailable": "nie udało się wczytać listy",

  // The shipped tooltip says the ready-made moments are in the list ABOVE, which stopped being true when
  // the field moved to the top of its section. Same text, one word honest again, and shorter.
  "setup.tip_shift": "Wypełnia datę powyżej czasem „teraz” przesuniętym o tyle - w wierszu poleceń to --at +30d. Miesiące, kwartały i lata trafiają w datę kalendarzową, nie w stałą liczbę godzin. Jedno przesunięcie i nic więcej: dni robocze są nieobecne, bo sesja nie nosi kalendarza świąt, a gotowe daty w rodzaju końca miesiąca stoją na liście niżej.",


  // The two options that can cost something. The tooltip carries the full story; these carry the part a
  // reader has to weigh BEFORE ticking, where the decision is made rather than a hover away from it.
  "setup.opt_qpc_note": "Animacja i wideo wewnątrz aplikacji mogą wyglądać źle.",
  "setup.opt_force_note": "Sesja jest wtedy wszędzie oznaczona jako niewiarygodna.",
  "setup.opt_embedded_note": "Otwiera na czas sesji lokalny port debugowania w silniku WWW aplikacji. Inne programy na tym komputerze mogą z niego korzystać, dopóki aplikacja działa.",
  "setup.opt_elevated_embedded_note": "Zapisuje na czas sesji jedną opcję WebView2 w rejestrze komputera i usuwa ją po sesji. Dopóki aplikacja działa, każdy program na tym komputerze może dotrzeć do jej stron, a aplikacja ma uprawnienia administratora.",
  "setup.opt_elevated_embedded_unavailable": "Dostępne, gdy Chrono Mock działa jako administrator.",
  "setup.opt_keep_timers_note": "Dla aplikacji Chromium i Electron oraz stron WWW wewnątrz aplikacji. Aplikacja pracuje pełnym tempem także wtedy, gdy jej okno jest zminimalizowane.",

  // Both of these say "target" in the shipped panel, which is the word this screen stopped using.
  "setup.tip_recent": "Aplikacje uruchamiane wcześniej. „Wybierz…” wskazuje taką, której ta maszyna jeszcze nie uruchamiała.",
  "setup.tip_start": "Uruchamia aplikację z fałszywym zegarem. Wymaga aplikacji i poprawnej daty.",

  // Shown only while the date field still holds the one this build ships with. A pre-filled date in 2038
  // looks arbitrary to a first reader, and an unexplained value is a value nobody trusts.
  "setup.default_moment_note": "Granica czasu 32-bitowego - częsty pierwszy test. Zmień ją albo wybierz scenariusz niżej.",

  // "Set" reads as already set, which is exactly what this row is not: it holds numbers nobody has
  // applied yet. The button says what pressing it does.
  "setup.action_fill": "Wypełnij datę",

  // Marks a recent target whose file is gone (a wiped build output, an uninstalled app). Shown rather than the entry being dropped, so the list never goes quiet about why a shortcut will not work (rule 6).
  "target.missing": "(brak pliku)",

  // Shown only while no target is chosen: dropping a file on the window is not discoverable on its own, and once there is a target the hint would be noise on every later run (chrono-mock 7.1 pt 1).
  "target.drop_hint": "…albo przeciągnij aplikację na to okno",
  "target.drop_rejected_title": "Tego pliku nie da się tu uruchomić",
  "target.drop_rejected": "W tym oknie można uruchomić tylko programy (.exe) i skróty do nich. Skrypt (.bat albo .cmd) uruchomisz poleceniem chrono w wierszu poleceń.",
  "target.one_at_a_time_title": "Jedna aplikacja naraz",
  "target.one_at_a_time": "Podano więcej niż jeden plik, a sesja uruchamia jedną aplikację. Wybierz jeden program (.exe) albo jeden skrót do niego.",
  "target.shortcut_rejected": "Ten skrót nie prowadzi do pliku programu (.exe) - skrót utworzony przez instalator go nie podaje. Wybierz zamiast niego sam program.",
  "target.program_missing": "Tego programu tu nie ma - został przeniesiony albo usunięty, albo jego dysk jest niedostępny.",

  // Arguments and working folder (chrono-mock 7.1 pt 1). Collapsed by default: most sessions need neither. The wire and the mechanism have carried both since the protocol was written; only the surfaces did not offer them.
  "launch.cwd_label": "Katalog roboczy:",

  // Time inputs (chrono-mock 7.1). The moment is the local time in the session zone (rule 2).
  "moment.date_placeholder": "YYYY-MM-DD",
  "moment.time_placeholder": "HH:MM",
  "moment.date_name": "Data",
  "moment.time_name": "Czas",
  "moment.date_empty": "Podaj datę.",
  "moment.date_format": "Użyj formatu YYYY-MM-DD.",
  "moment.date_invalid": "Taka data nie istnieje.",
  "moment.date_year_range": "Ten rok jest poza zakresem, jaki obsługuje to okno (1-9999). Kalkulator liczy na szerszym paśmie.",
  "moment.time_format": "Użyj HH:MM (format 24h).",
  // Reads the typed moment back in plain language (chrono-mock 7.1 pt 3). Only a lead-in: the date itself is formatted in the interface culture, so no sentence has to be assembled from fragments.
  "moment.preview_label": "Aplikacja zobaczy",
  "moment.relative_sign": "Kierunek",
  "moment.relative_amount": "Liczba",
  "moment.relative_unit": "Jednostka",
  "moment.relative_bad_amount": "Podaj liczbę całkowitą większą od zera, np. 30.",
  "moment.relative_failed": "Nie udało się zamienić tego przesunięcia na datę - może wypadać poza zakresem, w którym ta kompilacja liczy.",
  "action.pick_date": "Wybierz datę",
  "action.today": "Dziś",
  "action.now": "Teraz",

  // Market-name hints shown beside each offset in the zone dropdown, so it is not a bare number.
  "zone.host": "ta maszyna",
  "zone.utc": "Czas uniwersalny",
  "zone.pl_standard": "Polska (czas zimowy)",
  "zone.pl_summer": "Polska (czas letni)",
  "zone.us_eastern": "USA wschodni",
  "zone.us_central": "USA centralny",
  "zone.us_mountain": "USA górski",
  "zone.us_pacific": "USA pacyficzny",
  // 🔴 THE RATE, NOT A WORD FOR IT. This said the Polish word for "flowing", which named the mechanism rather than answering
  // "how fast" - and it sat in a list whose other four entries answer that question in one glyph. A
  // reader met it with no way to tell whether it was faster or slower than ×10. The key still names the
  // MODE, because that is its identity, and the wire value "flow" is untouched.
  //
  // Written ×1 rather than 1x to match the four beside it. A list mixing both notations would be a new
  // inconsistency traded for the one being removed.
  "mode.flow": "×1",
  "mode.frozen": "Zamrożony",
  // The same rate as mode.flow and deliberately the same text: this one is the in-session button that
  // sets the multiplier to 1, that one is the mode list's entry for starting at real speed. Two keys
  // because they are two controls in two phases, one reading because it is one rate.
  "mode.x1": "×1",
  "mode.x10": "×10",
  "mode.x60": "×60",
  "mode.x1440": "×1440",

  // Actions.
  "action.start": "Start",
  "action.choose_target": "Wybierz…",
  "action.browse_folder": "Przeglądaj…",
  "action.freeze": "Zamroź",
  "action.set_speed": "Ustaw",
  "speed.invalid": "Wpisz liczbę całkowitą, np. 500.",

  // In-flight jump deltas (units carried in the button Tag).
  "jump.minus_day": "-1 dzień",
  "jump.minus_hour": "-1 godz.",
  "jump.plus_hour": "+1 godz.",
  "jump.plus_day": "+1 dzień",

  // Session control (M-10). Meaning is carried by the label, never by colour alone.
  "control.stop": "Zatrzymaj sesję",

  // Session status. Meaning is carried by this label, never by colour alone.
  "status.idle": "Nie uruchomiono",
  "status.connecting": "Uruchamianie sesji",
  "status.running": "Działa",
  "status.ended": "Sesja zakończona",
  "status.did_not_take_effect": "Nie zadziałało - aplikacja zniknęła",
  "status.core_stopped": "Chrono Mock nieoczekiwanie się zatrzymał - aplikacja wróciła do realnego zegara",
  "status.stopping": "Zatrzymywanie - aplikacja wraca do realnego zegara",
  "status.refused": "Odmowa - fałszywy zegar nie zadziałał, więc sesja zakończyła aplikację",
  "status.stopped": "Sesja zatrzymana - aplikacja wróciła do realnego zegara",
  "status.core_unresponsive": "Chrono Mock przestał odpowiadać - aplikacja wróciła do realnego zegara",
  "status.core_missing": "Nie udało się uruchomić Chrono Mock - instalacja może być niekompletna",
  "status.target_unsupported": "To nie jest wspierany plik wykonywalny - wybierz aplikację .exe",
  "status.target_unreadable": "Nie udało się odczytać aplikacji - mogła zostać przeniesiona albo jest niedostępna",
  "status.no_ready": "Chrono Mock nie uruchomił się poprawnie",
  "status.error": "Błąd sesji",

  // Core failure reasons (RELEASE-001). When a start/fatal error ends a session, its specific reason becomes the status headline, so a failed start never reads as "Session ended". Phrased as failure statements because they ARE the status line. Emitted by the core (crates/cli, crates/mech).
  "core.hook_dll_missing": "Brakuje części Chrono Mocka, więc aplikacja nie została uruchomiona z fałszywym zegarem (zainstaluj Chrono Mock ponownie).",
  "protocol.version_mismatch": "Części Chrono Mock pochodzą z różnych wersji - rozpakuj paczkę ponownie, żeby wszystkie pochodziły z tej samej kompilacji.",
  "time.bad_mode": "Nieobsługiwany tryb czasu - sesja nie wystartowała.",
  // Rejected rather than applied: past the bound the fake clock leaves the representable date range
  // mid-session and the time channels start disagreeing, and a negative rate would run the clock
  // continuously backward - which the time model has as a jump, never as a speed.
  "time.bad_multiplier": "Prędkość poza zakresem - musi mieścić się między 0 (zamrożenie) a 1,000,000. Sesja nie wystartowała.",
  "moment.invalid": "Nieprawidłowa data i godzina (luka czasu letniego, 29 lutego w roku nieprzestępnym albo poza zakresem) - sesja nie wystartowała.",
  // R4-S7, R4-S9: both can answer a start AND a jump, so neither says which of the two did not happen,
  // and neither needs an in-flight twin (SessionViewModel.InFlightKey).
  "moment.out_of_range": "Ta data leży poza zakresem, który sesja potrafi przedstawić (lata 1601-30828), więc nie została użyta.",
  "time.bad_zone": "Strefa czasowa sesji jest pusta albo leży poza zakresem, który przyjmuje Chrono Mock (od -14:59 do +14:59) - wybierz inną strefę.",
  // 🔴 THE SAME TWO REASONS, FOR A COMMAND REJECTED MID-SESSION. The core sends one key whether a bad
  // moment arrives with the start command or with a jump, so the panel printed "the session did not
  // start" under a status line reading "Running" - a screen contradicting itself. These say what actually
  // did not happen. Which one is used is decided by the surface, not by the core (SessionViewModel.
  // InFlightKey), because only the surface knows which command the error answered.
  "moment.invalid_in_flight": "Nieprawidłowa data i godzina (luka czasu letniego, 29 lutego w roku nieprzestępnym albo poza zakresem) - zegar nie drgnął.",
  "time.bad_multiplier_in_flight": "Prędkość poza zakresem - musi mieścić się między 0 (zamrożenie) a 1,000,000. Tempo się nie zmieniło.",
  "moment.needs_calendar": "Ten skok liczy dni robocze, a trwająca sesja nie ma kalendarza - skocz do konkretnej daty albo policz ją najpierw w kalkulatorze.",
  "moment.unsupported_kind": "Chrono Mock nie rozpoznał tego rodzaju daty. To błąd w Chrono Mock - skopiuj diagnostykę i zgłoś go.",
  "session.control_failed": "Nie udało się ustawić łącza, którym Chrono Mock steruje sesją, więc fałszywy zegar nie zadziałał. Spróbuj ponownie - jeśli to się powtarza, skopiuj diagnostykę i zgłoś błąd.",
  "target.launch_failed": "Nie udało się uruchomić aplikacji, więc fałszywy zegar nie zadziałał. Sprawdź, czy plik nadal istnieje i czy Windows pozwala go uruchomić.",
  // Checked in the core before either mechanism starts. Without it the failure arrives as target.launch_failed, which blames the application for a folder that is simply not there.
  "target.cwd_missing": "Katalog roboczy nie istnieje - sesja nie wystartowała. Wskaż istniejący katalog albo zostaw pole puste, żeby aplikacja wystartowała tam, gdzie normalnie.",
  "target.inject_failed": "Nie udało się podłączyć fałszywego zegara do tej aplikacji - mógł to zablokować antywirus albo utwardzona aplikacja. Sprawdź, czy antywirus nie zatrzymał Chrono Mock.",
  // R4-S6. The application's own start failed while Windows was loading it, before the fake clock got its
  // turn. Windows's error window is kept off while it loads, so each text says how to see the name that
  // window would have shown. Before, these read as a single-instance vanish or, ten seconds later, a loader lock.
  "target.loader_dll_not_found": "Aplikacja nie wystartowała - Windows nie znalazł biblioteki (DLL), której potrzebuje, więc sesja się nie zaczęła. Uruchom ją raz bez Chrono Mock, a Windows poda nazwę brakującego pliku. Jeśli tak startuje bez problemu, ustaw katalog roboczy na ten, z którego zwykle startuje.",
  "target.loader_entry_missing": "Aplikacja nie wystartowała - biblioteka (DLL), którą ładuje, nie ma funkcji, której aplikacja potrzebuje (zwykle to inna wersja tej biblioteki), więc sesja się nie zaczęła. Uruchom ją raz bez Chrono Mock, a Windows poda nazwę funkcji i biblioteki.",
  "target.loader_bad_image": "Aplikacja nie wystartowała - Windows znalazł bibliotekę (DLL), której potrzebuje, ale nie mógł jej załadować (zwykle jest zbudowana dla innej bitowości, 32 zamiast 64 bitów albo odwrotnie, albo uszkodzona), więc sesja się nie zaczęła. Sprawdź, czy aplikacja startuje bez Chrono Mock z tego samego katalogu roboczego.",
  "target.loader_init_failed": "Aplikacja nie wystartowała - biblioteka (DLL), którą ładuje przy starcie, nie zdołała się zainicjować, więc sesja się nie zaczęła. Sprawdź, czy aplikacja startuje bez Chrono Mock.",
  "target.died_while_loading": "Aplikacja zakończyła się, zanim Windows skończył ją ładować, więc sesja się nie zaczęła. Kod, z którym się zakończyła, jest w diagnostyce (Kopiuj diagnostykę).",
  "target.attach_failed": "Nie udało się połączyć z aplikacją Chromium/Electron, więc fałszywy zegar nie zadziałał. Aplikacja może nie pozwalać na takie połączenie albo już działa jej kopia - zamknij działające kopie i spróbuj ponownie.",
  // R2-S1. The GUI normally catches this itself (HandshakeGate, from the target's PE), so this is the
  // core's own second line of defence - reachable for a target whose real bitness differs from what its
  // file header declares, such as a .NET AnyCPU executable.
  "target.bitness_mismatch": "Ta aplikacja działa w innej bitowości (32 albo 64 bity), niż deklaruje jej plik, więc część Chrono Mock wybrana według pliku nie podłączy do niej fałszywego zegara - zdarza się to przy niektórych aplikacjach .NET zbudowanych dla dowolnego procesora. Skopiuj diagnostykę i zgłoś błąd.",
  "session.already_active": "Inna sesja Chrono Mock już działa - tylko jedna naraz.",
  "protocol.no_command": "Sesja nie wystartowała - Chrono Mock nie dostał komendy jej startu. To błąd w Chrono Mock - skopiuj diagnostykę i zgłoś go.",
  "protocol.bad_command": "Sesja nie wystartowała - Chrono Mock dostał komendę, której nie potrafił odczytać. To błąd w Chrono Mock - skopiuj diagnostykę i zgłoś go.",
  "protocol.bad_command_ignored": "Chrono Mock nie odczytał komendy i ją pominął - sesja nadal trwa. Jeśli to się powtarza, zgłoś błąd.",
  // The two ways the command stream itself fails. They end the session, unlike a single unreadable command,
  // and each names what the client sent rather than blaming the core, which is what the silence used to do.
  "protocol.line_too_long": "Komenda była za długa, żeby Chrono Mock mógł ją odczytać, więc sesja się zakończyła. To błąd w Chrono Mock - skopiuj diagnostykę i zgłoś go.",
  "protocol.stream_unreadable": "Chrono Mock dostał bajty, których nie potrafi odczytać jako tekstu, więc sesja się zakończyła. To błąd w Chrono Mock - skopiuj diagnostykę i zgłoś go.",
  "protocol.unsupported_command": "Chrono Mock dostał komendę, której w tym miejscu nie obsługuje, i ją pominął - sesja nadal trwa. Jeśli to się powtarza, zgłoś błąd.",
  "proto.serialize_failed": "Chrono Mock nie zdołał zapisać jednego ze swoich komunikatów, więc w raporcie tej sesji może czegoś brakować. Uruchom sesję ponownie, a jeśli to się powtórzy, zgłoś to jako błąd Chrono Mock.",
  "protocol.expected_start": "Sesja nie wystartowała - Chrono Mock oczekiwał najpierw komendy startu. To błąd w Chrono Mock - skopiuj diagnostykę i zgłoś go.",

  // Handshake gate refusals (surfaced before the target is launched).
  "handshake.protocol_mismatch": "Części Chrono Mock z różnych wersji - nie uruchomiono. Rozpakuj paczkę ponownie.",
  "handshake.bitness_mismatch": "Pomieszane 32- i 64-bitowe części Chrono Mock - nie uruchomiono. Rozpakuj paczkę ponownie.",

