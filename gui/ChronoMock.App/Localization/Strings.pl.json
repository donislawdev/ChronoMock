// Polish interface strings. Keys are stable and English, values are the display text.
// This file is Strings.en.json with the values translated, and a new language is made the
// same way: copy that file, name it Strings.<culture>.json, translate the values, no
// recompile (untouchable rule 15). JSON with // comments: this file is DATA, read as data.
// It used to be XAML parsed by XamlReader, which instantiates types and therefore ran as
// code - a loose file next to the exe must never be able to do that.
{

  // The window title and the title bar. {0} is the product version, filled in at startup from the
  // running build - the number is never written here, so there is nothing extra to bump. A
  // translation that drops {0} gets a title without a version rather than an error.
  "app.title": "Chrono Mock {0}",

  // Clock roles.
  "clock.fake": "Zegar fałszywy",
  "clock.real": "Zegar rzeczywisty",

  // Target selection (chrono-mock 7.1). The dialog strings are keyed too (rule 15).
  "target.label": "Cel:",
  "target.dialog_title": "Wybierz cel",

  // Only .exe: native injection needs a PE and CDP needs an Electron/Chromium .exe. Narrowing the filter keeps a user from picking a .lnk/.bat/.txt that could only fail (RELEASE-007).
  "target.dialog_filter": "Pliki wykonywalne (*.exe)|*.exe",

  // Scenarios (chrono-mock 7.1 pt 2): named moments from the shared preset catalogue. The scenario NAMES and their "what this date tests" lines come from the catalogue files (data locales), not from here.
  "scenario.label": "Scenariusz",
  "scenario.needs_parameters": "kolejne scenariusze wymagają parametrów - zbuduj taki w kalkulatorze, potem użyj „Use in substitution”.",
  "scenario.failed": "Nie udało się policzyć daty dla tego scenariusza.",
  "scenario.unsupported": "Plik presetu tego scenariusza ma kształt, którego ta wersja nie czyta.",
  "scenario.engine_missing": "Nie udało się uruchomić silnika kalkulatora, więc scenariuszy nie da się policzyć.",

  // Marks a recent target whose file is gone (a wiped build output, an uninstalled app). Shown rather than the entry being dropped, so the list never goes quiet about why a shortcut will not work (rule 6).
  "target.missing": "(brak pliku)",

  // Shown only while no target is chosen: dropping a file on the window is not discoverable on its own, and once there is a target the hint would be noise on every later run (chrono-mock 7.1 pt 1).
  "target.drop_hint": "…albo przeciągnij aplikację na to okno",
  "target.drop_rejected": "Uruchomić można tylko pliki .exe - tego wymaga i hook, i wykrywanie Chromium.",

  // Arguments and working folder (chrono-mock 7.1 pt 1). Collapsed by default: most sessions need neither. The wire and the mechanism have carried both since the protocol was written; only the surfaces did not offer them.
  "launch.header": "Argumenty i katalog roboczy",
  "launch.args_label": "Argumenty:",
  "launch.cwd_label": "Katalog roboczy:",
  "launch.cwd_note": "Zostaw katalog pusty, żeby aplikacja wystartowała tam, gdzie normalnie. Argument ze spacjami ujmij w cudzysłów, dokładnie jak w wierszu poleceń.",

