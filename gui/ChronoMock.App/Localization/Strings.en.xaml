  <sys:String x:Key="calc.sig.start_of_month">First day of the month</sys:String>
  <sys:String x:Key="calc.sig.end_of_month">Last day of the month (month-end)</sys:String>
  <sys:String x:Key="calc.sig.start_of_quarter">First day of the quarter</sys:String>
