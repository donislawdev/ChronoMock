<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- English interface strings. Keys are stable and English; values are the display text. A new
       language is a copy of this file named Strings.<culture>.xaml with the values translated. -->
  <sys:String x:Key="app.title">Chrono Mock</sys:String>

  <!-- Clock roles. -->
  <sys:String x:Key="clock.fake">Fake clock</sys:String>
  <sys:String x:Key="clock.real">Real clock</sys:String>

  <!-- Target selection (chrono-mock 7.1). The dialog strings are keyed too (rule 15). -->
  <sys:String x:Key="target.label">Target:</sys:String>
  <sys:String x:Key="target.dialog_title">Choose target</sys:String>
  <sys:String x:Key="target.dialog_filter">Executables (*.exe)|*.exe|All files (*.*)|*.*</sys:String>

  <!-- Time inputs (chrono-mock 7.1). The moment is the local time in the session zone (rule 2). -->
  <sys:String x:Key="moment.label">At:</sys:String>
  <sys:String x:Key="moment.invalid">Enter a moment like 2038-01-19T03:14:07 (date and time).</sys:String>
  <sys:String x:Key="zone.label">Zone:</sys:String>
  <sys:String x:Key="mode.label">Mode:</sys:String>
  <sys:String x:Key="mode.flow">Flowing</sys:String>
  <sys:String x:Key="mode.frozen">Frozen</sys:String>
  <sys:String x:Key="mode.x1">×1</sys:String>
  <sys:String x:Key="mode.x10">×10</sys:String>
  <sys:String x:Key="mode.x60">×60</sys:String>
  <sys:String x:Key="mode.x1440">×1440</sys:String>
  <sys:String x:Key="mode.scale_duration">Scale duration too</sys:String>

  <!-- Actions. -->
  <sys:String x:Key="action.start">Start</sys:String>
  <sys:String x:Key="action.choose_target">Choose…</sys:String>
  <sys:String x:Key="action.freeze">Freeze</sys:String>
  <sys:String x:Key="action.jump_to">Jump to</sys:String>
  <sys:String x:Key="action.set_speed">Set</sys:String>

  <!-- In-flight jump deltas (units carried in the button Tag). -->
  <sys:String x:Key="jump.minus_day">-1 day</sys:String>
  <sys:String x:Key="jump.minus_hour">-1 hour</sys:String>
  <sys:String x:Key="jump.plus_hour">+1 hour</sys:String>
  <sys:String x:Key="jump.plus_day">+1 day</sys:String>

  <!-- Session control (M-10). Meaning is carried by the label, never by colour alone. -->
  <sys:String x:Key="control.stop">Stop session</sys:String>

  <!-- Session status. Meaning is carried by this label, never by colour alone. -->
  <sys:String x:Key="status.idle">Not started</sys:String>
  <sys:String x:Key="status.connecting">Starting the core</sys:String>
  <sys:String x:Key="status.running">Running</sys:String>
  <sys:String x:Key="status.ended">Session ended</sys:String>
  <sys:String x:Key="status.did_not_take_effect">Did not take effect - the target vanished</sys:String>
  <sys:String x:Key="status.core_stopped">Core stopped - the target time is frozen</sys:String>
  <sys:String x:Key="status.stopped">Session stopped - the target is back on real time</sys:String>
  <sys:String x:Key="status.core_unresponsive">Core not responding - stopped, the target is back on real time</sys:String>
  <sys:String x:Key="status.core_missing">Cannot start the demo session - build the solution first</sys:String>
  <sys:String x:Key="status.no_ready">No handshake from the core</sys:String>
  <sys:String x:Key="status.error">Session error</sys:String>

  <!-- Handshake gate refusals (surfaced before the target is launched). -->
  <sys:String x:Key="handshake.protocol_mismatch">Protocol version mismatch - not started</sys:String>
  <sys:String x:Key="handshake.bitness_mismatch">Core bitness mismatch - not started</sys:String>

  <!-- Verifier verdict (chrono-mock 7.1). The label is paired with a glyph and a colour. -->
  <sys:String x:Key="verdict.works">Works</sys:String>
  <sys:String x:Key="verdict.partial">Partial</sys:String>
  <sys:String x:Key="verdict.fails">Fails</sys:String>
  <sys:String x:Key="verdict.undetermined">Undetermined</sys:String>
  <sys:String x:Key="verdict.unknown">Unknown</sys:String>

  <!-- One-sentence "what this means for the test" for a non-works verdict. -->
  <sys:String x:Key="verdict.partial.meaning">Some time channels were not covered - their readings are real, so the test may be unreliable.</sys:String>
  <sys:String x:Key="verdict.fails.meaning">The swap did not cover the key channels - the session was refused as unreliable.</sys:String>
  <sys:String x:Key="verdict.undetermined.meaning">Coverage could not be determined - treated as unproven, never as working.</sys:String>

  <!-- Coverage / audit preview (chrono-mock 7.2). Channel names are raw API identifiers, not translated. -->
  <sys:String x:Key="coverage.covered">Covered channels</sys:String>
  <sys:String x:Key="coverage.observed">Observed (hooked, left real)</sys:String>
  <sys:String x:Key="coverage.uncovered">Uncovered channels</sys:String>
  <sys:String x:Key="coverage.warnings">Warnings</sys:String>
  <sys:String x:Key="coverage.family_note">Family session - showing the parent process coverage.</sys:String>
  <sys:String x:Key="coverage.contexts_note">Chromium session - showing every JS context (page and workers), never summed.</sys:String>

  <!-- Chromium/Electron (CDP) mode, ADR-8/ADR-9: verdict reasons and warnings the CDP core emits. The
       coverage unit is a JS context, not an OS process. -->
  <sys:String x:Key="chromium.contexts_covered">Every JS context ran on the session clock.</sys:String>
  <sys:String x:Key="chromium.contexts_partial">Some JS contexts ran on the session clock; some could not be reached.</sys:String>
  <sys:String x:Key="chromium.no_time_calls">The shim was installed, but the app called no JS time API.</sys:String>
  <sys:String x:Key="chromium.no_contexts">No JS context could be shimmed.</sys:String>
  <sys:String x:Key="chromium.launched_with_debug_port">Electron/Chromium app: launched with a remote-debugging port and a clean isolated profile, not your real one.</sys:String>
  <sys:String x:Key="chromium.app_closed_before_audit">The app closed before the audit could read final call counts - the coverage may be incomplete.</sys:String>
  <sys:String x:Key="chromium.rate_change_affects_running_timers">The speed changed in flight: new timers and the clock reflect it at once, but a setInterval already running keeps its old cadence.</sys:String>

  <!-- Copy session summary (chrono-mock 7.2, 8.8). A paste-into-ticket report; a non-works session leads
       with the unreliable-evidence banner. Keys ending in a template carry {0}-style placeholders. -->
  <sys:String x:Key="action.copy_summary">Copy summary</sys:String>
  <sys:String x:Key="copy.done">Copied to clipboard</sys:String>
  <sys:String x:Key="copy.failed">Could not copy - the clipboard is busy</sys:String>
  <sys:String x:Key="report.unreliable_banner">!! UNRELIABLE EVIDENCE - the time substitution did not fully take effect. Do not cite this as proof of behavior.</sys:String>
  <sys:String x:Key="report.title">Chrono Mock - session report</sys:String>
  <sys:String x:Key="report.target">target</sys:String>
  <sys:String x:Key="report.verdict">verdict</sys:String>
  <sys:String x:Key="report.no_verdict">no verdict emitted</sys:String>
  <sys:String x:Key="report.did_not_take_effect">DID NOT TAKE EFFECT - the target vanished right after injection</sys:String>
  <sys:String x:Key="report.vanish_detail">suspected single-instance app: {0} - lived {1} ms</sys:String>
  <sys:String x:Key="report.processes">processes: {0}</sys:String>
  <sys:String x:Key="report.session">session</sys:String>
  <sys:String x:Key="report.session_reached">fake clock reached {0}</sys:String>
  <sys:String x:Key="report.elapsed">real {0}s, fake {1}s</sys:String>
  <sys:String x:Key="report.requested">requested: {0} (zone {1}, mode {2})</sys:String>

  <!-- Session history (chrono-mock 7.2, 8.8, 11.1 pt 13). Local-only; clicking an entry fills the setup
       form and never starts a session (untouchable rule 7, docs/04 section 6). -->
  <sys:String x:Key="history.header">History</sys:String>
  <sys:String x:Key="history.save_failed">Could not save to history:</sys:String>
  <sys:String x:Key="history.delete">Delete this session</sys:String>
  <sys:String x:Key="history.clear">Clear</sys:String>
  <sys:String x:Key="history.clear_title">Clear history</sys:String>
  <sys:String x:Key="history.clear_confirm">Clear all recorded sessions? This cannot be undone.</sys:String>

  <!-- Module switch: the two halves of the product (chrono-mock 6.1/7). -->
  <sys:String x:Key="nav.substitution">Substitution</sys:String>
  <sys:String x:Key="nav.calculator">Calculator</sys:String>

  <!-- Date calculator (chrono-mock 7.3). Slice G1 is the layout shell; more keys arrive with the wiring. -->
  <sys:String x:Key="calc.presets_header">Presets</sys:String>
  <sys:String x:Key="calc.filter_placeholder">Filter scenarios…</sys:String>
  <sys:String x:Key="calc.build_from_scratch">+ Build from scratch</sys:String>
  <sys:String x:Key="calc.preset_note">A preset is a starting point - not a certificate that your test is complete.</sys:String>
  <sys:String x:Key="calc.preset_params_header">Parameters</sys:String>
  <sys:String x:Key="calc.preset_needs_params">Fill in the parameters below to compute this preset.</sys:String>
  <sys:String x:Key="calc.build_header">Build the moment</sys:String>
  <sys:String x:Key="calc.start_point">Start point</sys:String>
  <sys:String x:Key="calc.steps_header">Steps</sys:String>
  <sys:String x:Key="calc.add_step">+ Add step</sys:String>
  <sys:String x:Key="calc.kind_shift">Shift ±</sys:String>
  <sys:String x:Key="calc.kind_snap">Snap to</sys:String>
  <sys:String x:Key="calc.kind_nearest">Nearest</sys:String>
  <sys:String x:Key="calc.kind_settime">Set time</sys:String>
  <sys:String x:Key="calc.kind_zone">Change zone</sys:String>
  <sys:String x:Key="calc.result_header">Result</sys:String>
  <sys:String x:Key="calc.what_tests">What this date tests</sys:String>
  <sys:String x:Key="calc.all_formats">All formats - one click to copy</sys:String>
  <sys:String x:Key="calc.copy">Copy</sys:String>
  <sys:String x:Key="calc.custom_format">Custom format</sys:String>
  <sys:String x:Key="calc.custom_format_hint">e.g. yyyy-MM-dd HH:mm:ss</sys:String>
  <sys:String x:Key="calc.metadata">Metadata</sys:String>
  <sys:String x:Key="calc.other_zones">Same instant, other zones</sys:String>
  <sys:String x:Key="calc.use_in_substitution">Use in substitution →</sys:String>
  <sys:String x:Key="calc.reverse_header">Analyze a pasted date</sys:String>
  <sys:String x:Key="calc.analyze_ambiguous">Ambiguous - both interpretations shown</sys:String>
  <sys:String x:Key="calc.reading.iso">ISO 8601 (unambiguous)</sys:String>
  <sys:String x:Key="calc.reading.us_month_day">US reading (MM/DD/YYYY)</sys:String>
  <sys:String x:Key="calc.reading.pl_day_month">PL reading (DD/MM/YYYY)</sys:String>

  <!-- Calculator builder (G3b): base kinds, shift units, calendars, and the significance markers. -->
  <sys:String x:Key="calc.base.today">Today</sys:String>
  <sys:String x:Key="calc.base.now">Now</sys:String>
  <sys:String x:Key="calc.base.specific">Specific date</sys:String>
  <sys:String x:Key="calc.field_calendar">Calendar:</sys:String>
  <sys:String x:Key="calc.remove_step">Remove step</sys:String>

  <sys:String x:Key="calc.unit.seconds">seconds</sys:String>
  <sys:String x:Key="calc.unit.minutes">minutes</sys:String>
  <sys:String x:Key="calc.unit.hours">hours</sys:String>
  <sys:String x:Key="calc.unit.days">days</sys:String>
  <sys:String x:Key="calc.unit.weeks">weeks</sys:String>
  <sys:String x:Key="calc.unit.months">months</sys:String>
  <sys:String x:Key="calc.unit.quarters">quarters</sys:String>
  <sys:String x:Key="calc.unit.years">years</sys:String>
  <sys:String x:Key="calc.unit.business_days">business days</sys:String>

  <sys:String x:Key="calc.cal.none">(none)</sys:String>
  <sys:String x:Key="calc.cal.us_banking">US banking</sys:String>
  <sys:String x:Key="calc.cal.us_federal">US federal</sys:String>
  <sys:String x:Key="calc.cal.pl">Poland</sys:String>

  <!-- Snap-step targets (G3c-1): the period boundary the step jumps to. Tokens mirror the snap flag. -->
  <sys:String x:Key="calc.snap.som">Start of month</sys:String>
  <sys:String x:Key="calc.snap.eom">End of month</sys:String>
  <sys:String x:Key="calc.snap.soq">Start of quarter</sys:String>
  <sys:String x:Key="calc.snap.eoq">End of quarter</sys:String>
  <sys:String x:Key="calc.snap.soy">Start of year</sys:String>
  <sys:String x:Key="calc.snap.eoy">End of year</sys:String>

  <!-- Nearest-step targets (G3c-2): roll to the nearest business day in a direction. Needs a calendar. -->
  <sys:String x:Key="calc.nearest.nbd">Next business day</sys:String>
  <sys:String x:Key="calc.nearest.pbd">Previous business day</sys:String>

  <sys:String x:Key="calc.sig.start_of_month">First day of the month</sys:String>
  <sys:String x:Key="calc.sig.end_of_month">Last day of the month (month-end)</sys:String>
  <sys:String x:Key="calc.sig.start_of_quarter">First day of the quarter</sys:String>
  <sys:String x:Key="calc.sig.end_of_quarter">Last day of the quarter (quarter-end)</sys:String>
  <sys:String x:Key="calc.sig.start_of_year">First day of the year</sys:String>
  <sys:String x:Key="calc.sig.end_of_year">Last day of the year (year-end rollover)</sys:String>
  <sys:String x:Key="calc.sig.leap_day">February 29 - leap day</sys:String>
  <sys:String x:Key="calc.sig.last_day_of_february_common_year">February 28 - last day of February (common year, no Feb 29)</sys:String>
  <sys:String x:Key="calc.sig.unix_epoch">Unix epoch (1970-01-01T00:00:00Z, epoch 0)</sys:String>
  <sys:String x:Key="calc.sig.year_2038_boundary">At or past the 2038-01-19 32-bit time_t limit (Y2038)</sys:String>
  <sys:String x:Key="calc.sig.weekend">Weekend - not a business day</sys:String>
  <sys:String x:Key="calc.sig.public_holiday">Public holiday</sys:String>
  <sys:String x:Key="calc.sig.observed_holiday">Observed public holiday - a day off shifted from a weekend holiday</sys:String>

</ResourceDictionary>
