  <sys:String x:Key="calc.weekday.tuesday">Tuesday</sys:String>
  <sys:String x:Key="calc.weekday.wednesday">Wednesday</sys:String>
  <sys:String x:Key="calc.weekday.thursday">Thursday</sys:String>
