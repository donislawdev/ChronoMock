  <sys:String x:Key="calc.unit.business_days">business days</sys:String>

  <sys:String x:Key="calc.cal.none">(none)</sys:String>
  <sys:String x:Key="calc.cal.us_banking">US banking</sys:String>
  <sys:String x:Key="calc.cal.us_federal">US federal</sys:String>
  <sys:String x:Key="calc.cal.pl">Poland</sys:String>

  <!-- Snap-step targets (G3c-1): the period boundary the step jumps to. Tokens mirror the snap flag. -->
  <sys:String x:Key="calc.snap.som">Start of month</sys:String>
  <sys:String x:Key="calc.snap.eom">End of month</sys:String>
  <sys:String x:Key="calc.snap.soq">Start of quarter</sys:String>
  <sys:String x:Key="calc.snap.eoq">End of quarter</sys:String>
