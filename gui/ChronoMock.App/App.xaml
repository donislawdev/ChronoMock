<Application x:Class="ChronoMock.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ChronoMock.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--
          Order is load-bearing (measured method from the betterwindowsservices project):
          the wpfui dictionaries come FIRST and our own come LAST, because a later-merged
          dictionary wins. Within ours, Values before Colours (StaticResource resolves as the
          file is read). There is deliberately NO ThemeMode on <Application>: set together with
          the wpfui dictionaries it throws at startup (AllowsTransparency after the window shows).
        -->
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="Themes/Values.xaml" />
        <ResourceDictionary Source="Themes/Colours.xaml" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- App-wide so both the window and the clock tiles resolve it. Renders a translation key (as the
           core and the VM emit) to text in the current language (untouchable rules 15/16). -->
      <local:TranslationKeyConverter x:Key="KeyToText" />

      <!-- Verdict indicator: the glyph and colour come from the verdict kind, colour from the named palette. -->
      <local:VerdictGlyphConverter x:Key="VerdictGlyph" />
      <local:VerdictBrushConverter x:Key="VerdictBrush" />
      <BooleanToVisibilityConverter x:Key="BoolToVis" />

      <!-- Accessible name for templated combo items. A combo item's automation Name is otherwise the
           bound record's ToString() (a screen reader would read the raw "UnitOption { Token = d, ... }"),
           because the peer reads the data item, not the template's TextBlock. Resolve the item's LabelKey
           to the translated label on the container, so assistive tech hears the human label (rules 15/16).
           Based on the wpfui item style so the dark item visuals are preserved. -->
      <Style x:Key="LabelKeyComboItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
        <Setter Property="AutomationProperties.Name" Value="{Binding LabelKey, Converter={StaticResource KeyToText}}" />
      </Style>

      <!-- Zone items: the offset and the market it belongs to, in that order, because the offset is the
           fact and the market is the gloss - a bare "US Pacific" would not say what the session will run
           on. Two bindings rather than a LabelKey, since a zone option carries a computed Label (the
           offset) beside its translation key, so LabelKeyComboItem cannot name it. Without this the peer
           reads the record's ToString(), which is how both zone dropdowns came to announce
           "ZoneOption { BiasMinutes = -120, Label = ... }" to assistive tech (rules 15/16). -->
      <Style x:Key="ZoneComboItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
        <Setter Property="AutomationProperties.Name">
          <Setter.Value>
            <MultiBinding StringFormat="{}{0}, {1}">
              <Binding Path="Label" />
              <Binding Path="HintKey" Converter="{StaticResource KeyToText}" />
            </MultiBinding>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Recent-target items: the accessible name is the FULL path, because the file name alone does not
           identify a build (an x64 and an x86 output are both app.exe) and assistive tech would otherwise
           hear the record's ToString(). Same reason the row shows the directory beside the name. -->
      <Style x:Key="RecentTargetComboItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
        <Setter Property="AutomationProperties.Name" Value="{Binding FullPath}" />
      </Style>

      <!-- Scenario chips: the accessible name is the scenario's own name, which the template shows - without
           this the peer would read the record's ToString(), as it would for any templated item. -->
      <!-- 🔴 A REAL CHIP, not text that happens to be clickable. Under the stock item template these read
           as eight loose phrases with wide gaps and no edges, so nothing said they could be pressed and
           nothing showed which one was chosen - the selected state only appeared on hover. A drawn border
           plus a filled selected state is the cheapest thing that turns a list of words into a control.
           Selection is carried by the border and the text weight as well as by colour (zasady/13 9), so it
           survives a monochrome screenshot and a colour-blind reader. -->
      <Style x:Key="ScenarioListItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
        <Setter Property="Margin" Value="{StaticResource SpaceXs}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Chip"
                      Background="{DynamicResource BrushBgSurfaceAlt}"
                      BorderBrush="{DynamicResource BrushStroke}"
                      BorderThickness="{StaticResource StrokeThinEdge}"
                      CornerRadius="{StaticResource RadiusSm}"
                      Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Chip" Property="Background" Value="{DynamicResource BrushAccent}" />
                  <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                  <Setter Property="Foreground" Value="{DynamicResource BrushBgBase}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource BrushFocusRing}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
