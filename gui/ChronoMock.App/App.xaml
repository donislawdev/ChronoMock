<Application x:Class="ChronoMock.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ChronoMock.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--
          Order is load-bearing (measured method from the betterwindowsservices project):
          the wpfui dictionaries come FIRST and our own come LAST, because a later-merged
          dictionary wins. Within ours, Values before Colours (StaticResource resolves as the
          file is read). There is deliberately NO ThemeMode on <Application>: set together with
          the wpfui dictionaries it throws at startup (AllowsTransparency after the window shows).
        -->
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="Themes/Values.xaml" />
        <ResourceDictionary Source="Themes/Colours.xaml" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
        <!-- The parts library, merged application-wide as of the product transition (P3b), so the calculator
             and the dialogs take their controls from it through implicit styles. It comes after Values and
             Colours because its StaticResource sizes resolve as the file is read. The phase views, the audit
             and the catalogue ALSO merge it locally and MUST keep doing so - a {StaticResource PartX} inside a
             UserControl is resolved as that control's BAML loads, a lookup that never reaches
             Application.Resources (only implicit styles and DynamicResource reach it, at tree time). -->
        <ResourceDictionary Source="Themes/Parts.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- App-wide so both the window and the clock tiles resolve it. Renders a translation key (as the
           core and the VM emit) to text in the current language (untouchable rules 15/16). -->
      <local:TranslationKeyConverter x:Key="KeyToText" />
      <local:AuditRowsConverter x:Key="AuditRows" />
      <local:UncoveredProcessRowsConverter x:Key="UncoveredProcessRows" />
      <local:EngineRowsConverter x:Key="EngineRows" />
      <local:PagesReachedNoteConverter x:Key="PagesReachedNote" />

      <!-- Verdict indicator: the glyph and colour come from the verdict kind, colour from the named palette. -->
      <local:VerdictGlyphConverter x:Key="VerdictGlyph" />
      <local:VerdictBrushConverter x:Key="VerdictBrush" />
      <BooleanToVisibilityConverter x:Key="BoolToVis" />

      <!-- Accessible name for templated combo items. A combo item's automation Name is otherwise the
           bound record's ToString() (a screen reader would read the raw "UnitOption { Token = d, ... }"),
           because the peer reads the data item, not the template's TextBlock. Resolve the item's LabelKey
           to the translated label on the container, so assistive tech hears the human label (rules 15/16).
           Based on the wpfui item style so the dark item visuals are preserved. -->
      <Style x:Key="LabelKeyComboItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
        <Setter Property="AutomationProperties.Name" Value="{Binding LabelKey, Converter={StaticResource KeyToText}}" />
      </Style>

      <!-- Zone items (ZoneComboItem, ZoneRow) live in Themes/Parts.xaml with the rest of the parts, so both
           zone pickers draw and name a zone from one definition. -->

      <!-- RecentTargetComboItem and ScenarioListItem lived here, keyed item styles the shipped monolith
           bound - they went with it when the product moved to the phases (the phases carry their own). -->
    </ResourceDictionary>
  </Application.Resources>
</Application>
