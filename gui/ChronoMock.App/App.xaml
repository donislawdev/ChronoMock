<Application x:Class="ChronoMock.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ChronoMock.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--
          Order is load-bearing (measured method from the betterwindowsservices project):
          the wpfui dictionaries come FIRST and our own come LAST, because a later-merged
          dictionary wins. Within ours, Values before Colours (StaticResource resolves as the
          file is read). There is deliberately NO ThemeMode on <Application>: set together with
          the wpfui dictionaries it throws at startup (AllowsTransparency after the window shows).
        -->
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="Themes/Values.xaml" />
        <ResourceDictionary Source="Themes/Colours.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- App-wide so both the window and the clock tiles resolve it. Renders a translation key (as the
           core and the VM emit) to text in the current language (untouchable rules 15/16). -->
      <local:TranslationKeyConverter x:Key="KeyToText" />

      <!-- Verdict indicator: the glyph and colour come from the verdict kind, colour from the named palette. -->
      <local:VerdictGlyphConverter x:Key="VerdictGlyph" />
      <local:VerdictBrushConverter x:Key="VerdictBrush" />
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
