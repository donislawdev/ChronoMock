<Project>
  <!--
    Shared conventions for every gui/ project. Single source of truth: a copy in an
    individual .csproj silently wins and gives you two sources of one setting, so these
    live here and are not repeated per project (method from the betterwindowsservices
    project). RuntimeIdentifier deliberately does NOT live here - it belongs to publish,
    and forced into shared props it breaks the test host.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <!-- Lets a non-Windows machine restore these Windows-targeting projects. We never build
         on Linux - every workflow we own runs on windows-latest - but GitHub's automatic
         dependency submission restores each csproj on a Linux runner to feed the dependency
         graph, and without this it fails with NETSDK1100, so the graph never learns our
         transitive NuGet dependencies. This is the documented resolution and Microsoft
         allows it in a Directory.Build.props. It only permits the Windows targeting packs to
         be downloaded when cross-targeting, so a build on Windows is unaffected - and the
         same doc asks that releases be built on Windows, which is where ours are built. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- How far the SDK audits NuGet packages during restore. These are the SDK 10.0.400 defaults,
         written down rather than inherited, because together with TreatWarningsAsErrors above they
         already form a vulnerability gate that nobody had declared - an NU1901-NU1904 warning is a
         build error here. Measured before writing this: a deliberately vulnerable System.Net.Http
         4.3.0 fails the build with NU1903. A future SDK narrowing a default (mode "all" back to
         "direct", say) would shrink that gate silently, and nothing in the repository would say so.
         The cost is worth knowing: an advisory published against a package nobody touched turns the
         next build red. That is the trade audit.yml makes weekly for Rust, except here it lands on
         the push - which for a test-only dependency tree is the cheaper end of the bargain. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Product identity and version for every gui/ assembly (shows in the exe's Details tab).
         Single source for the GUI stack. The version WILL change across releases - bump it here
         (and the Rust workspace version in the root Cargo.toml, which drives the CLI exe). The
         assistant does not bump it on its own (untouchable rule 18). -->
    <Version>0.1.0</Version>
    <Company>DonislawDev</Company>
    <Authors>DonislawDev</Authors>
    <Product>Chrono Mock</Product>
    <Copyright>Copyright (C) 2026 DonislawDev. Licensed under GPL-3.0-only.</Copyright>
    <!-- Keep ProductVersion a clean "0.1.0" - do not append the git commit hash to it. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
