<Project>
  <!--
    Shared conventions for every gui/ project. Single source of truth: a copy in an
    individual .csproj silently wins and gives you two sources of one setting, so these
    live here and are not repeated per project (method from the betterwindowsservices
    project). RuntimeIdentifier deliberately does NOT live here - it belongs to publish,
    and forced into shared props it breaks the test host.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <!-- Lets a non-Windows machine restore these Windows-targeting projects. We never build
         on Linux - every workflow we own runs on windows-latest - but GitHub's automatic
         dependency submission restores each csproj on a Linux runner to feed the dependency
         graph, and without this it fails with NETSDK1100, so the graph never learns our
         transitive NuGet dependencies. This is the documented resolution and Microsoft
         allows it in a Directory.Build.props. It only permits the Windows targeting packs to
         be downloaded when cross-targeting, so a build on Windows is unaffected - and the
         same doc asks that releases be built on Windows, which is where ours are built. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- No project here uses the Windows Runtime projection, so none carries it (R5/8b). The 10.0.17763 in
         the window's TFM pins the support floor (see ChronoMock.App.csproj), and any TFM version from 10.0 up
         also makes the SDK add the projection: Microsoft.Windows.SDK.NET.dll and WinRT.Runtime.dll, 23.6 MB
         and 0.5 MB in every package. Of the 225 managed assemblies in the package, none but the projection
         itself referenced either of them, and no start loaded them. Measured with this switched off: the
         unpacked package fell from 169.6 to 146.6 MB, every method of ChronoMock.dll kept its IL, and the
         floor stayed in the assembly as SupportedOSPlatform Windows10.0.17763.0. It also took out the one
         component in the package that carried no SPDX licence. A restore still downloads the pack into the
         NuGet cache, as it does the ASP.NET Core runtime pack, and neither ships.

         🔴 The switch is the SDK's own (Microsoft.NET.Windows.targets sets it to true only when a project
         leaves it empty), but it has no page on learn.microsoft.com. The documented way out, a TFM with no
         version, drops the floor to Windows 7.0, and a higher SupportedOSPlatformVersion beside it is
         refused (NETSDK1135). So the effect is checked where it ships: packaging/build-dist.ps1 stops when
         either file is in the publish, which is what an SDK that stopped honouring this would cause. A
         project that does need a Windows Runtime API sets it to true and declares the projection in
         packaging/components.json and THIRD-PARTY-NOTICES.md. -->
    <IncludeWindowsSDKRefFrameworkReferences>false</IncludeWindowsSDKRefFrameworkReferences>
    <!-- Record the exact bytes of every NuGet package these projects restore, in a packages.lock.json
         beside each csproj. Until 2026-09-08 the managed half had no integrity record at all: Cargo.lock
         carries a checksum for all 44 third-party crates, while `WPF-UI 4.3.0` was fetched fresh on every
         restore with nothing written down about what arrived. The lock file is NuGet's own answer and a
         stronger one than a hash copied into a test by hand, because it covers the transitive set too.
         Enforced where it matters: on a runner, restore refuses a lock file that no longer matches the
         manifests instead of quietly rewriting it, so a dependency cannot change under a release build. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- How far the SDK audits NuGet packages during restore. These are the SDK 10.0.400 defaults,
         written down rather than inherited, because together with TreatWarningsAsErrors above they
         already form a vulnerability gate that nobody had declared - an NU1901-NU1904 warning is a
         build error here. Measured before writing this: a deliberately vulnerable System.Net.Http
         4.3.0 fails the build with NU1903. A future SDK narrowing a default (mode "all" back to
         "direct", say) would shrink that gate silently, and nothing in the repository would say so.
         The cost is worth knowing: an advisory published against a package nobody touched turns the
         next build red. That is the trade audit.yml makes weekly for Rust, except here it lands on
         the push - which for a test-only dependency tree is the cheaper end of the bargain. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Product identity and version for every gui/ assembly (shows in the exe's Details tab).
         Single source for the GUI stack. The version WILL change across releases - bump it here
         (and the Rust workspace version in the root Cargo.toml, which drives the CLI exe). The
         assistant does not bump it on its own (untouchable rule 18). -->
    <Version>0.4.0</Version>
    <Company>DonislawDev</Company>
    <Authors>DonislawDev</Authors>
    <Product>Chrono Mock</Product>
    <Copyright>Copyright (C) 2026 DonislawDev. Licensed under GPL-3.0-only.</Copyright>
    <!-- Keep ProductVersion a clean "0.1.0" - do not append the git commit hash to it. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!--
    Metric ceilings (CA1502 cyclomatic complexity, CA1506 class coupling). The numbers and the
    reasoning live in CodeMetricsConfig.txt beside this file; the severities that switch the two
    rules on live in gui/.editorconfig. This is the only wiring: the analyzer reads its thresholds
    from an AdditionalFiles entry NAMED CodeMetricsConfig.txt, which is why the tightened copy used
    by the pinning run carries the same file name in a different directory.

    The indirection through a property is what lets CI point the same build at the tightened copy
    (-p:ChronoMetricsConfig=<abs path>) and require THAT build to fail. Pass an absolute path: an
    AdditionalFiles item is resolved against each project's own directory, so a repository-relative
    path would silently resolve to nothing and the pinning run would pass for the wrong reason.
  -->
  <PropertyGroup>
    <ChronoMetricsConfig Condition="'$(ChronoMetricsConfig)' == ''">$(MSBuildThisFileDirectory)CodeMetricsConfig.txt</ChronoMetricsConfig>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(ChronoMetricsConfig)" />
  </ItemGroup>
</Project>
