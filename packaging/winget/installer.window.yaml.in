# Rendered by packaging/build-feeds.ps1 - do not edit the generated copy.
# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.{{WINGET_SCHEMA}}.schema.json

PackageIdentifier: {{WINGET_ID}}
PackageVersion: {{VERSION}}
ReleaseDate: {{RELEASE_DATE}}
# Two installers, and their ORDER is load-bearing.
#
# Only the Windows installer puts the window in the Start menu. A portable
# package cannot have a shortcut at all: the manifest schema has no field for
# one, WinGet's portable installer makes none, and microsoft/winget-cli#2299
# asking for it has been open since 2022. The installer comes FIRST because
# that is what decides a fresh install: recent clients prefer it over portable
# when the user has set no preference (microsoft/winget-cli#6123), and older
# ones keep the first installer that applies when nothing else tells two apart.
#
# The archive comes SECOND, with no scope, for --scope user: a person without
# administrator rights, for whom the installer is out of reach because it is
# for the whole machine. The description says that such an install gets no
# Start menu entry. Keep it once it is published: WinGet upgrades only within
# the kind that is installed, and portable is compatible with nothing but
# portable, so a manifest without it would leave every such install where it
# is for good.
Installers:
- Architecture: x64
  InstallerType: wix
  Scope: machine
  # Windows Installer asks for elevation itself.
  ElevationRequirement: elevatesSelf
  InstallerUrl: {{MSI_URL}}
  InstallerSha256: {{MSI_SHA256}}
  # How WinGet recognises the installed program from one release to the next,
  # an install made from the release page by hand included: the UpgradeCode
  # never changes, while every build gets a new ProductCode.
  AppsAndFeaturesEntries:
  - UpgradeCode: '{{MSI_UPGRADE_CODE}}'
  Commands:
  - chrono
- Architecture: x64
  InstallerType: zip
  NestedInstallerType: portable
  # No ArchiveBinariesDependOnPath, on purpose. WinGet then starts the window
  # through a link in its own links folder, and the .NET host follows the link:
  # the runtime and the window's own assemblies load from the real folder, the
  # one the window finds its cores and catalogues in (tools/feeds/
  # symlink-probe.ps1 on Windows Server 2025, 2026-11-02). With
  # the field, WinGet would put the package's own folder on PATH instead, and
  # that folder holds the whole .NET runtime, more than two hundred libraries
  # that any program searching PATH for a library could then load.
  NestedInstallerFiles:
  - RelativeFilePath: {{APP_ZIP_EXE}}
  InstallerUrl: {{APP_ZIP_URL}}
  InstallerSha256: {{APP_ZIP_SHA256}}
  Commands:
  - ChronoMock
ManifestType: installer
ManifestVersion: {{WINGET_SCHEMA}}
