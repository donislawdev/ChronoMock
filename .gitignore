/tools/

# === Build output ===
# Rust
/target/
**/*.rs.bk
# Assembled portable distribution (packaging/build-dist.ps1)
/dist/
# .NET
[Bb]in/
[Oo]bj/
*.user
*.suo

# The user's GLOBAL gitignore (~/.gitignore, a Unity template) ignores *.csproj and *.sln.
# Re-include our C# build-definition files here (a repo .gitignore overrides the global). These
# are defensive: a silently-dropped Directory.Build.props is worse than a broken clone, because
# the clone still builds - just without our shared settings (TreatWarningsAsErrors, Nullable).
!*.csproj
!*.sln
!*.slnx
!*.props
!*.targets

# === OS / editor noise ===
.DS_Store
Thumbs.db
.vs/
.vscode/
.idea/
*.swp
